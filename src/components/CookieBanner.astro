---
// GDPR-venligt cookiebanner med Google Consent Mode v2.
// Ligeværdige knapper ("Accepter alle" og "Kun nødvendige") jf. Datatilsynets vejledning.
---
<div class="cookie on-dark" id="cookie-banner" role="dialog" aria-modal="false" aria-labelledby="cookie-title" hidden>
  <div class="cookie__inner">
    <div class="cookie__text">
      <h2 id="cookie-title" class="cookie__title">Cookies på procad.dk</h2>
      <p>Jeg bruger kun nødvendige cookies, medmindre du siger ja til statistik og marketing. Så kan jeg se, hvilke sider der bliver brugt, og måle annoncer. <a href="/cookiepolitik/" class="link">Læs cookiepolitikken</a>.</p>

      <form class="cookie__prefs" id="cookie-prefs" hidden>
        <label class="check"><input type="checkbox" checked disabled /> <span><strong>Nødvendige</strong> – får sitet og formularen til at virke.</span></label>
        <label class="check"><input type="checkbox" name="analytics" /> <span><strong>Statistik</strong> – Google Analytics 4, anonymiseret brug af sitet.</span></label>
        <label class="check"><input type="checkbox" name="marketing" /> <span><strong>Marketing</strong> – Google Ads-konverteringer og genmålretning.</span></label>
      </form>
    </div>
    <div class="cookie__actions">
      <button type="button" class="btn btn-primary btn-sm" data-consent="all">Accepter alle</button>
      <button type="button" class="btn btn-secondary btn-sm" data-consent="necessary">Kun nødvendige</button>
      <button type="button" class="btn btn-secondary btn-sm" data-consent="toggle" aria-expanded="false" aria-controls="cookie-prefs">Vælg selv</button>
      <button type="button" class="btn btn-secondary btn-sm" data-consent="save" hidden>Gem mit valg</button>
    </div>
  </div>
</div>

<style>
  .cookie { position: fixed; z-index: 60; left: 1rem; right: 1rem; bottom: 1rem; max-width: 56rem; margin-inline: auto; background: var(--c-graphite); color: #eee; border: 2px solid #000; box-shadow: var(--shadow-hard-orange); }
  .cookie[hidden] { display: none; }
  .cookie__inner { display: grid; gap: 1rem; padding: 1.25rem; }
  @media (min-width: 48rem) { .cookie__inner { grid-template-columns: 1fr auto; align-items: end; padding: 1.5rem; } }
  .cookie__title { font-size: var(--fs-xl); color: #fff; margin-bottom: .4rem; }
  .cookie p { font-size: var(--fs-sm); max-width: 60ch; }
  .cookie__prefs { display: grid; gap: .6rem; margin-top: 1rem; }
  .cookie__prefs[hidden] { display: none; }
  .cookie__actions { display: grid; gap: .5rem; }
  .cookie__actions [hidden] { display: none; }
</style>

<script>
  type Consent = { v: 1; analytics: boolean; marketing: boolean; ts: string };
  const KEY = 'procad-consent';
  const banner = document.getElementById('cookie-banner') as HTMLElement | null;
  const prefs = document.getElementById('cookie-prefs') as HTMLFormElement | null;
  const btn = (k: string) => banner?.querySelector<HTMLButtonElement>(`[data-consent="${k}"]`);

  function read(): Consent | null {
    try { return JSON.parse(localStorage.getItem(KEY) || 'null'); } catch { return null; }
  }
  function save(analytics: boolean, marketing: boolean) {
    const c: Consent = { v: 1, analytics, marketing, ts: new Date().toISOString() };
    try { localStorage.setItem(KEY, JSON.stringify(c)); } catch {}
    (window as any).procadApplyConsent?.(c);
    (window as any).dataLayer?.push({ event: 'consent_update', consent_analytics: analytics, consent_marketing: marketing });
    if (banner) banner.hidden = true;
  }
  function open() {
    if (!banner) return;
    const c = read();
    if (prefs && c) {
      (prefs.elements.namedItem('analytics') as HTMLInputElement).checked = c.analytics;
      (prefs.elements.namedItem('marketing') as HTMLInputElement).checked = c.marketing;
    }
    banner.hidden = false;
    btn('all')?.focus();
  }

  if (!read()) open();
  btn('all')?.addEventListener('click', () => save(true, true));
  btn('necessary')?.addEventListener('click', () => save(false, false));
  btn('toggle')?.addEventListener('click', (e) => {
    const t = e.currentTarget as HTMLButtonElement;
    const show = prefs?.hidden ?? false;
    if (prefs) prefs.hidden = !show;
    t.setAttribute('aria-expanded', String(show));
    t.hidden = show;
    const s = btn('save'); if (s) s.hidden = !show;
  });
  btn('save')?.addEventListener('click', () => {
    const a = (prefs?.elements.namedItem('analytics') as HTMLInputElement)?.checked ?? false;
    const m = (prefs?.elements.namedItem('marketing') as HTMLInputElement)?.checked ?? false;
    save(a, m);
  });
  document.querySelectorAll('[data-cookie-settings]').forEach((el) => el.addEventListener('click', open));
</script>
