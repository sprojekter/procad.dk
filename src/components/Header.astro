---
import { getCollection } from 'astro:content';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { mainNav } from '../data/site';

const services = (await getCollection('ydelser')).sort((a, b) => a.data.order - b.data.order);
const icons = ['ruler', 'file', 'cube', 'doc'] as const;
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="hdr">
  <div class="container hdr__inner">
    <a href="/" class="hdr__logo" aria-label="ProCAD – til forsiden"><Logo /></a>

    <nav id="hovedmenu" class="nav" aria-label="Hovedmenu">
      <ul class="nav__list">
        <li class="nav__item nav__item--sub">
          <a href="/ydelser/" class:list={['nav__link', { 'is-active': isActive('/ydelser/') }]}>Ydelser</a>
          <button class="nav__subtoggle" type="button" aria-expanded="false" aria-controls="submenu-ydelser">
            <span class="sr-only">Vis ydelser</span>
            <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5l3 3 3-3" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" /></svg>
          </button>
          <div id="submenu-ydelser" class="mega">
            <ul class="mega__grid">
              {services.map((s, i) => (
                <li>
                  <a href={`/ydelser/${s.id}/`} class="mega__link">
                    <Icon icon={icons[i % icons.length]} />
                    <span>
                      <span class="mega__title">{s.data.navTitle}</span>
                      <span class="mega__desc">{s.data.navDescription}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
            <div class="mega__foot">
              <span class="muted">Ved du ikke, hvad du skal bruge?</span>
              <a href="/kontakt/" class="link">Send det, du har</a>
            </div>
          </div>
        </li>
        {mainNav.filter((i) => i.href !== '/kontakt/').map((item) => (
          <li class="nav__item">
            <a href={item.href} class:list={['nav__link', { 'is-active': isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
      <div class="nav__actions">
        <a href="/kontakt/" class="nav__link nav__contact">Kontakt</a>
        <a href="/kontakt/" class="btn btn-primary btn-sm">Få et tilbud</a>
      </div>
    </nav>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="hovedmenu">
      <span class="sr-only">Menu</span>
      <span class="menu-toggle__bars" aria-hidden="true"></span>
    </button>
  </div>
</header>

<style>
  .hdr { position: sticky; top: 0; z-index: 50; background: rgba(247,247,245,.8); backdrop-filter: saturate(180%) blur(16px); -webkit-backdrop-filter: saturate(180%) blur(16px); border-bottom: 1px solid transparent; transition: border-color .2s ease; }
  .hdr.is-scrolled { border-bottom-color: var(--c-line); }
  .hdr__inner { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: var(--header-h); }
  .hdr__logo :global(svg) { height: 28px; width: auto; }

  .menu-toggle { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border: 0; background: transparent; cursor: pointer; border-radius: 10px; }
  .menu-toggle__bars, .menu-toggle__bars::before { display: block; width: 18px; height: 1.5px; background: var(--c-ink); position: relative; transition: transform .25s var(--ease); }
  .menu-toggle__bars::before { content: ""; position: absolute; top: 6px; }
  .menu-toggle__bars { transform: translateY(-3px); }
  .menu-toggle[aria-expanded="true"] .menu-toggle__bars { transform: rotate(45deg); }
  .menu-toggle[aria-expanded="true"] .menu-toggle__bars::before { transform: translateY(-6px) rotate(-90deg); }

  /* Mobil */
  .nav { display: none; position: absolute; inset: 100% 0 auto 0; background: var(--c-paper); border-bottom: 1px solid var(--c-line); padding: .5rem clamp(1.25rem, 3vw, 2.5rem) 1.5rem; max-height: calc(100dvh - var(--header-h)); overflow-y: auto; }
  .nav.is-open { display: block; }
  .nav__list { list-style: none; margin: 0; padding: 0; }
  .nav__item { display: flex; flex-wrap: wrap; align-items: center; border-bottom: 1px solid var(--c-line); }
  .nav__link { flex: 1; display: block; padding: .95rem 0; text-decoration: none; font-size: 1.0625rem; font-weight: 500; color: var(--c-ink); }
  .nav__subtoggle { width: 2.75rem; height: 2.75rem; display: grid; place-items: center; background: none; border: 0; cursor: pointer; color: var(--c-muted); }
  .nav__subtoggle[aria-expanded="true"] svg { transform: rotate(180deg); }
  .mega { display: none; width: 100%; padding-bottom: 1rem; }
  .mega.is-open { display: block; }
  .mega__grid { list-style: none; margin: 0; padding: 0; display: grid; gap: .25rem; }
  .mega__link { display: flex; gap: .85rem; align-items: center; padding: .6rem; border-radius: 12px; text-decoration: none; }
  .mega__link:hover { background: var(--c-white); }
  .mega__title { display: block; font-weight: 500; color: var(--c-ink); font-size: .9375rem; }
  .mega__desc { display: block; font-size: var(--fs-xs); color: var(--c-muted); }
  .mega__foot { display: none; }
  .nav__actions { display: grid; gap: .75rem; margin-top: 1.25rem; }
  .nav__contact { display: none; }

  @media (min-width: 64rem) {
    .menu-toggle { display: none; }
    .nav { display: flex; flex: 1; justify-content: space-between; align-items: center; position: static; padding: 0 0 0 2.5rem; border: 0; max-height: none; overflow: visible; background: none; }
    .nav__list { display: flex; align-items: center; gap: .25rem; }
    .nav__item { border: 0; position: relative; flex-wrap: nowrap; }
    .nav__link { padding: .45rem .7rem; font-size: .9375rem; font-weight: 450; color: var(--c-muted); border-radius: 8px; transition: color .15s ease; }
    .nav__link:hover, .nav__link.is-active { color: var(--c-ink); }
    .nav__subtoggle { width: 1.25rem; height: 2.25rem; margin-left: -.55rem; }
    .mega { position: absolute; top: calc(100% + .9rem); left: -1rem; width: 36rem; padding: .6rem; background: var(--c-white); border: 1px solid var(--c-line); border-radius: 18px; box-shadow: var(--shadow-lg); }
    .mega__grid { grid-template-columns: 1fr 1fr; }
    .mega__link:hover { background: var(--c-paper); }
    .mega__foot { display: flex; justify-content: space-between; align-items: center; margin-top: .4rem; padding: .85rem .6rem .4rem; border-top: 1px solid var(--c-line); font-size: var(--fs-sm); }
    .nav__item--sub:hover .mega, .nav__item--sub:focus-within .mega { display: block; }
    .nav__item--sub:hover::after { content: ""; position: absolute; left: 0; right: 0; top: 100%; height: 1rem; }
    .nav__actions { display: flex; align-items: center; gap: .5rem; margin: 0; }
    .nav__contact { display: block; flex: none; }
  }
</style>

<script>
  const hdr = document.querySelector<HTMLElement>('.hdr');
  const onScroll = () => hdr?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll(); window.addEventListener('scroll', onScroll, { passive: true });

  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.getElementById('hovedmenu');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('is-open', !open);
  });
  const sub = document.querySelector<HTMLButtonElement>('.nav__subtoggle');
  const mega = document.getElementById('submenu-ydelser');
  sub?.addEventListener('click', () => {
    const open = sub.getAttribute('aria-expanded') === 'true';
    sub.setAttribute('aria-expanded', String(!open));
    mega?.classList.toggle('is-open', !open);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (mega?.classList.contains('is-open')) { mega.classList.remove('is-open'); sub?.setAttribute('aria-expanded', 'false'); sub?.focus(); }
    else if (nav?.classList.contains('is-open')) { nav.classList.remove('is-open'); toggle?.setAttribute('aria-expanded', 'false'); toggle?.focus(); }
  });
</script>
