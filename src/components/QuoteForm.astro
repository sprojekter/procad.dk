---
// Tilbudsformular v4 – to trin: 1) Opgaven  2) Hvem svarer jeg.
// Bruges indlejret (kontakt, ydelsessider) og i den globale dialog (QuoteDialog).
// Uden JS vises begge trin på én gang, og formularen sendes almindeligt (filfeltet har navn).
// Sender multipart til site.formEndpoint: /api/tilbud.php på Simply (15 MB) eller FormSubmit (10 MB).
import { getCollection } from 'astro:content';
import { site } from '../data/site';

interface Props {
  id?: string;
  preselect?: string;   // ydelse-id der vælges på forhånd
  heading?: string;
  inDialog?: boolean;
}
const { id = 'tilbud', preselect = '', heading, inDialog = false } = Astro.props;
const services = (await getCollection('ydelser')).sort((a, b) => a.data.order - b.data.order);
const endpoint = site.formEndpoint;
const isFormSubmit = endpoint.includes('formsubmit.co');
const maxMB = isFormSubmit ? 10 : 15;
const accept = '.pdf,.dxf,.dwg,.step,.stp,.iges,.igs,.jpg,.jpeg,.png,.heic,.webp,.zip';
const f = (n: string) => `${id}-${n}`;
const deadlines = ['Hurtigst muligt', 'Inden for en uge', 'Inden for en måned', 'Ingen hast'];
---
<form
  class:list={['qf', { 'qf--dialog': inDialog }]}
  id={id}
  action={endpoint}
  method="post"
  enctype="multipart/form-data"
  novalidate
  data-quote-form
  data-max-mb={maxMB}
  data-dialog={inDialog ? '1' : undefined}
>
  {heading && <h2 class="qf__heading">{heading}</h2>}

  <div class="qf__progress" aria-hidden="true" data-progress>
    <span data-progress-label>Trin 1 af 2: Opgaven</span>
    <span class="qf__bar"><span data-progress-bar></span></span>
  </div>

  <div class="qf__errors" role="alert" tabindex="-1" hidden data-errors></div>

  <!-- Trin 1: Opgaven -->
  <fieldset class="qf__step is-active" data-step="1">
    <legend class="sr-only">Trin 1 af 2: Opgaven</legend>

    <div class="qf__set" role="radiogroup" aria-labelledby={f('ydelse-l')}>
      <span class="qf__label" id={f('ydelse-l')}>Hvad skal du have lavet? <span class="hint">valgfrit</span></span>
      <div class="chips">
        {services.map((s) => (
          <label class="chip">
            <input type="radio" name="Ydelse" value={s.data.navTitle} checked={s.id === preselect} data-service={s.id} />
            <span>{s.data.navTitle.replace(' (DXF/STEP)', '')}</span>
          </label>
        ))}
        <label class="chip"><input type="radio" name="Ydelse" value="Ved ikke endnu" /><span>Ved ikke</span></label>
      </div>
    </div>

    <div class="field">
      <label for={f('besk')}>Beskriv opgaven</label>
      <textarea class="input" id={f('besk')} name="Beskrivelse" rows="3"
        placeholder="Fx 40 stk. bukket beslag i 3 mm S235. Skal bruge DXF til laser."></textarea>
    </div>

    <div class="field">
      <span class="qf__label" id={f('filer-l')}>Filer, skitse eller foto</span>
      <div class="qf__pick">
        <label class="dropzone" data-dropzone>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V4m-4.5 4.5L12 4l4.5 4.5M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3"/></svg>
          <span class="qf__pick-fine"><strong>Træk filer hertil</strong> eller <u>vælg filer</u></span>
          <span class="qf__pick-coarse"><strong>Vælg filer</strong></span>
          <input type="file" name="attachment" multiple accept={accept} aria-labelledby={f('filer-l')} data-files />
        </label>
        <label class="btn btn-secondary qf__camera">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4z"/><circle cx="12" cy="13" r="3.5"/></svg>
          Tag foto
          <input type="file" accept="image/*" capture="environment" data-files class="sr-only" />
        </label>
      </div>
      <span class="hint">PDF, DXF, DWG, STEP, IGES, billeder eller ZIP – maks. {maxMB} MB i alt.</span>
      <ul class="qf__files" data-file-list aria-live="polite"></ul>
      <div class="qf__meter" hidden data-meter><span data-meter-bar></span></div>
      <span class="field-error" data-file-error></span>
    </div>

    <div class="field">
      <label for={f('link')}>Link til store filer <span class="hint">valgfrit – fx WeTransfer eller Dropbox</span></label>
      <input class="input" id={f('link')} name="Link" type="url" inputmode="url" placeholder="https://" />
    </div>

    <div class="qf__set" role="radiogroup" aria-labelledby={f('tid-l')}>
      <span class="qf__label" id={f('tid-l')}>Hvornår skal du bruge det? <span class="hint">valgfrit</span></span>
      <div class="chips">
        {deadlines.map((d) => <label class="chip"><input type="radio" name="Tidsplan" value={d} /><span>{d}</span></label>)}
      </div>
    </div>

    <div class="qf__actions" data-js-only>
      <button type="button" class="btn btn-primary qf__next" data-next-step>Fortsæt</button>
    </div>
  </fieldset>

  <!-- Trin 2: Hvem svarer jeg -->
  <fieldset class="qf__step" data-step="2">
    <legend class="sr-only">Trin 2 af 2: Dine oplysninger</legend>
    <div class="qf__grid">
      <div class="field">
        <label for={f('navn')}>Navn <span class="req" aria-hidden="true">*</span></label>
        <input class="input" id={f('navn')} name="Navn" type="text" autocomplete="name" required data-msg="Skriv dit navn." />
      </div>
      <div class="field">
        <label for={f('email')}>E-mail <span class="req" aria-hidden="true">*</span></label>
        <input class="input" id={f('email')} name="email" type="email" autocomplete="email" inputmode="email" required data-msg="Skriv en gyldig e-mail, fx navn@firma.dk." />
      </div>
      <div class="field">
        <label for={f('tlf')}>Telefon <span class="hint">valgfrit</span></label>
        <input class="input" id={f('tlf')} name="Telefon" type="tel" autocomplete="tel" inputmode="tel" />
      </div>
      <div class="field">
        <label for={f('firma')}>Firma <span class="hint">valgfrit</span></label>
        <input class="input" id={f('firma')} name="Firma" type="text" autocomplete="organization" />
      </div>
    </div>
    <div class="qf__set" role="radiogroup" aria-labelledby={f('kontakt-l')}>
      <span class="qf__label" id={f('kontakt-l')}>Hvordan vil du helst have svar?</span>
      <div class="chips">
        <label class="chip"><input type="radio" name="Kontakt" value="Mail" checked /><span>Mail</span></label>
        <label class="chip"><input type="radio" name="Kontakt" value="Ring mig op" /><span>Ring mig op</span></label>
      </div>
    </div>

    <p class="qf__privacy">Dine oplysninger og filer bruges kun til at besvare forespørgslen og deles ikke. <a href="/privatlivspolitik/">Privatlivspolitik</a></p>

    <div class="qf__actions">
      <button type="button" class="btn btn-secondary" data-prev-step data-js-only>Tilbage</button>
      <button type="submit" class="btn btn-primary qf__send" data-submit>
        <span class="qf__spinner" aria-hidden="true"></span>
        <span data-label>Send og få fast pris</span>
      </button>
    </div>
    <p class="hint qf__promise">Svar inden for {site.responseHours} timer på hverdage.</p>
  </fieldset>

  <!-- Spambeskyttelse og opsætning -->
  <input type="text" name="_honey" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <input type="hidden" name="_ts" value="" data-ts />
  {isFormSubmit && <input type="hidden" name="_captcha" value="false" />}
  {isFormSubmit && <input type="hidden" name="_template" value="table" />}
  <input type="hidden" name="_subject" value="Ny tilbudsforespørgsel fra procad.dk" />
  <input type="hidden" name="_next" value="" data-next />
  <input type="hidden" name="Side" value={Astro.url.pathname} data-side />
  {site.turnstileSiteKey && <div class="cf-turnstile" data-sitekey={site.turnstileSiteKey} data-language="da"></div>}
</form>

{site.turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<style>
  .qf { display: grid; gap: 1.25rem; }
  .qf__heading { font-size: var(--fs-xl); letter-spacing: -0.025em; }
  .qf__step { border: 0; padding: 0; margin: 0; min-width: 0; display: grid; gap: 1.25rem; }
  .qf__set { display: grid; gap: .55rem; }
  .qf__label, .field label { font-weight: 500; font-size: var(--fs-sm); color: var(--c-ink); }
  .req { color: var(--c-orange); }
  .qf__grid { display: grid; gap: 1rem; }
  @media (min-width: 36rem) { .qf__grid { grid-template-columns: 1fr 1fr; } }

  /* Trin-tilstand (kun med JS) */
  .qf__progress { display: none; }
  .qf.is-steps .qf__progress { display: grid; gap: .45rem; font-size: var(--fs-xs); color: var(--c-muted); font-weight: 500; }
  .qf__bar { height: 3px; border-radius: 99px; background: var(--c-line); overflow: hidden; }
  .qf__bar span { display: block; height: 100%; width: 50%; background: var(--c-orange); transition: width .3s var(--ease); }
  .qf.is-steps .qf__step:not(.is-active) { display: none; }
  .qf:not(.is-steps) [data-js-only] { display: none; }

  /* Chips – mindst 44 px høje (tap targets) */
  .chips { display: flex; flex-wrap: wrap; gap: .5rem; }
  .chip { position: relative; }
  .chip input { position: absolute; opacity: 0; inset: 0; cursor: pointer; margin: 0; }
  .chip span { display: inline-flex; align-items: center; min-height: 2.75rem; padding: .4rem 1rem; border: 1px solid var(--c-field); border-radius: 999px; font-size: .9375rem; color: var(--c-ink); background: var(--c-white); transition: border-color .15s ease, background-color .15s ease, color .15s ease; cursor: pointer; }
  .chip:hover span { border-color: var(--c-ink); }
  .chip input:checked + span { background: var(--c-ink); color: var(--c-on-ink); border-color: var(--c-ink); }
  .chip input:focus-visible + span { box-shadow: var(--ring); }

  /* Filvalg: træk-og-slip på mus, knapper på touch */
  .qf__pick { display: grid; gap: .5rem; }
  .qf__camera { display: none; position: relative; }
  .qf__pick-coarse { display: none; }
  @media (pointer: coarse) {
    .qf__pick { grid-template-columns: 1fr 1fr; }
    .qf__camera { display: inline-flex; }
    .qf__pick-fine { display: none; }
    .qf__pick-coarse { display: inline; }
    .qf__pick .dropzone { padding: .7rem; min-height: 2.875rem; grid-auto-flow: column; justify-content: center; border-style: solid; border-color: var(--c-line); background: var(--c-white); }
  }
  .qf__files { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .4rem; }
  .qf__files:empty { display: none; }
  .qf__files li { display: inline-flex; align-items: center; gap: .25rem; max-width: 100%; padding: 0 0 0 .75rem; border: 1px solid var(--c-line); background: var(--c-paper); border-radius: 999px; font-size: var(--fs-xs); color: var(--c-ink); }
  .qf__files li span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 13rem; }
  .qf__files li small { color: var(--c-muted); }
  .qf__files button { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 50%; border: 0; background: transparent; color: var(--c-muted); cursor: pointer; }
  .qf__files button:hover { color: var(--c-ink); }
  .qf__meter { height: 4px; background: var(--c-line); border-radius: 99px; overflow: hidden; }
  .qf__meter span { display: block; height: 100%; width: 0; background: var(--c-ink); transition: width .3s var(--ease); }
  .qf__meter.is-over span { background: var(--c-danger); }

  .qf__errors { padding: .85rem 1rem; border-radius: var(--r-md); border: 1px solid color-mix(in srgb, var(--c-danger) 40%, transparent); background: color-mix(in srgb, var(--c-danger) 8%, var(--c-white)); font-size: var(--fs-sm); color: var(--c-ink); }
  .qf__privacy { font-size: var(--fs-xs); color: var(--c-muted); }
  .qf__privacy a { color: var(--c-ink); text-underline-offset: 3px; }
  .qf__actions { display: flex; gap: .5rem; }
  .qf__actions .btn { min-height: 3rem; }
  .qf__next, .qf__send { flex: 1; }
  .qf--dialog .qf__actions { position: sticky; bottom: 0; padding: .75rem 0 calc(.75rem + env(safe-area-inset-bottom)); margin-bottom: -.75rem; background: linear-gradient(transparent, var(--c-white) 25%); z-index: 1; }
  .qf__promise { text-align: center; }
  .qf__spinner { display: none; width: 1rem; height: 1rem; border-radius: 50%; border: 2px solid currentColor; border-right-color: transparent; animation: qf-spin .7s linear infinite; }
  .qf.is-sending .qf__spinner { display: inline-block; }
  .qf.is-sending .qf__send { pointer-events: none; opacity: .85; }
  @keyframes qf-spin { to { transform: rotate(360deg); } }
  .field-error:empty { display: none; }
</style>

<script>
  const OK_EXT = ['pdf', 'dxf', 'dwg', 'step', 'stp', 'iges', 'igs', 'jpg', 'jpeg', 'png', 'heic', 'heif', 'webp', 'zip'];
  const MAX_FILES = 15;
  const fmt = (b: number) => (b >= 1048576 ? `${(b / 1048576).toFixed(1).replace('.', ',')} MB` : `${Math.max(1, Math.round(b / 1024))} kB`);

  document.querySelectorAll<HTMLFormElement>('[data-quote-form]').forEach((form) => {
    const MAX = Number(form.dataset.maxMb || 10) * 1048576;
    const inputs = Array.from(form.querySelectorAll<HTMLInputElement>('[data-files]'));
    const list = form.querySelector<HTMLUListElement>('[data-file-list]')!;
    const fileErr = form.querySelector<HTMLElement>('[data-file-error]')!;
    const meter = form.querySelector<HTMLElement>('[data-meter]')!;
    const bar = form.querySelector<HTMLElement>('[data-meter-bar]')!;
    const zone = form.querySelector<HTMLElement>('[data-dropzone]')!;
    const errors = form.querySelector<HTMLElement>('[data-errors]')!;
    const steps = Array.from(form.querySelectorAll<HTMLElement>('.qf__step'));
    const progressLabel = form.querySelector<HTMLElement>('[data-progress-label]')!;
    const progressBar = form.querySelector<HTMLElement>('[data-progress-bar]')!;
    const draftKey = `procad-draft-${form.id}`;
    let files: File[] = [];
    let step = 1;

    // Med JS: trin-visning, og filfeltet sendes via egen liste (fjern navnet)
    form.classList.add('is-steps');
    inputs.forEach((i) => i.removeAttribute('name'));
    (form.querySelector('[data-ts]') as HTMLInputElement).value = String(Date.now());

    const showStep = (n: number, focus = true) => {
      step = n;
      steps.forEach((s) => s.classList.toggle('is-active', Number(s.dataset.step) === n));
      progressLabel.textContent = n === 1 ? 'Trin 1 af 2: Opgaven' : 'Trin 2 af 2: Dine oplysninger';
      progressBar.style.width = n === 1 ? '50%' : '100%';
      if (focus) (steps[n - 1].querySelector('input:not([type=radio]):not([type=file]), textarea') as HTMLElement | null)?.focus({ preventScroll: false });
      form.dispatchEvent(new CustomEvent('qf:step', { bubbles: true, detail: n }));
    };

    // ---------- Filer ----------
    const renderFiles = () => {
      list.innerHTML = '';
      let total = 0;
      files.forEach((file, i) => {
        total += file.size;
        const li = document.createElement('li');
        li.innerHTML = `<span></span><small>${fmt(file.size)}</small><button type="button"><svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 2l8 8M10 2l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></button>`;
        (li.querySelector('span') as HTMLElement).textContent = file.name;
        const b = li.querySelector('button')!;
        b.setAttribute('aria-label', `Fjern ${file.name}`);
        b.addEventListener('click', () => { files.splice(i, 1); renderFiles(); });
        list.appendChild(li);
      });
      meter.hidden = files.length === 0;
      bar.style.width = `${Math.min(100, (total / MAX) * 100)}%`;
      meter.classList.toggle('is-over', total > MAX);
      fileErr.textContent = total > MAX ? `Filerne fylder ${fmt(total)} – maks. ${fmt(MAX)}. Fjern en fil, eller indsæt et link til store filer.` : '';
    };
    const addFiles = (incoming: FileList | File[]) => {
      const bad: string[] = [];
      Array.from(incoming).forEach((file) => {
        const ext = file.name.split('.').pop()?.toLowerCase() || '';
        if (!OK_EXT.includes(ext) && !file.type.startsWith('image/')) { bad.push(file.name); return; }
        if (files.length >= MAX_FILES) { bad.push(file.name); return; }
        if (!files.some((f) => f.name === file.name && f.size === file.size)) files.push(file);
      });
      renderFiles();
      if (bad.length) fileErr.textContent = `${bad.join(', ')} kan ikke sendes (filtype eller maks. ${MAX_FILES} filer). Pak i en ZIP, eller brug et link.`;
    };
    inputs.forEach((i) => i.addEventListener('change', () => { addFiles(i.files || []); i.value = ''; }));
    ['dragenter', 'dragover'].forEach((t) => zone.addEventListener(t, (e) => { e.preventDefault(); zone.classList.add('is-dragover'); }));
    ['dragleave', 'drop'].forEach((t) => zone.addEventListener(t, () => zone.classList.remove('is-dragover')));
    zone.addEventListener('drop', (e) => { e.preventDefault(); const dt = (e as DragEvent).dataTransfer; if (dt?.files) addFiles(dt.files); });
    // Filer sendt fra et dropfelt andre steder på siden (åbner dialogen)
    if (form.dataset.dialog) window.addEventListener('procad:quote-files', (e) => addFiles((e as CustomEvent<File[]>).detail));

    // ---------- Kladde ----------
    const textFields = () => Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input[type=text], input[type=email], input[type=tel], input[type=url], textarea, input[type=radio]'));
    try {
      const d = JSON.parse(localStorage.getItem(draftKey) || '{}');
      textFields().forEach((el) => {
        if (el.name.startsWith('_') || !(el.name in d)) return;
        if (el.type === 'radio') { if (d[el.name] === el.value) (el as HTMLInputElement).checked = true; }
        else el.value = d[el.name];
      });
    } catch {}
    let t: number | undefined;
    form.addEventListener('input', () => {
      clearTimeout(t);
      t = window.setTimeout(() => {
        const d: Record<string, string> = {};
        new FormData(form).forEach((v, k) => { if (typeof v === 'string' && !k.startsWith('_') && k !== 'Side') d[k] = v; });
        try { localStorage.setItem(draftKey, JSON.stringify(d)); } catch {}
      }, 400);
    });

    // ---------- Validering ----------
    const setErr = (el: HTMLElement, msg: string) => {
      el.setAttribute('aria-invalid', String(!!msg));
      let err = document.getElementById(`${el.id}-err`);
      if (!err) {
        err = document.createElement('span');
        err.id = `${el.id}-err`; err.className = 'field-error';
        el.insertAdjacentElement('afterend', err);
        el.setAttribute('aria-describedby', err.id);
      }
      err.textContent = msg;
      return msg;
    };
    const checkReq = (el: HTMLInputElement) => setErr(el, el.value.trim() !== '' && el.checkValidity() ? '' : el.dataset.msg || 'Udfyld feltet.');
    form.querySelectorAll<HTMLInputElement>('[required]').forEach((el) => {
      el.addEventListener('blur', () => { if (el.value) checkReq(el); });
      el.addEventListener('input', () => { if (el.getAttribute('aria-invalid') === 'true') checkReq(el); });
    });

    const showErrors = (problems: { el: HTMLElement; msg: string }[]) => {
      if (!problems.length) { errors.hidden = true; return true; }
      errors.hidden = false;
      errors.innerHTML = `<strong>${problems.length === 1 ? 'Ret dette' : 'Ret disse ' + problems.length + ' ting'}:</strong><ul></ul>`;
      problems.forEach((p) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `#${p.el.id}`; a.textContent = p.msg;
        a.addEventListener('click', (ev) => { ev.preventDefault(); p.el.focus(); });
        li.appendChild(a); errors.querySelector('ul')!.appendChild(li);
      });
      errors.focus();
      return false;
    };
    const validateStep1 = () => {
      const besk = form.querySelector<HTMLTextAreaElement>('textarea[name=Beskrivelse]')!;
      const link = form.querySelector<HTMLInputElement>('input[name=Link]')!;
      const problems: { el: HTMLElement; msg: string }[] = [];
      if (!besk.value.trim() && !files.length && !link.value.trim()) problems.push({ el: besk, msg: setErr(besk, 'Skriv et par linjer, vedhæft en fil eller indsæt et link.') });
      else setErr(besk, '');
      if (link.value.trim() && !link.checkValidity()) problems.push({ el: link, msg: setErr(link, 'Linket skal starte med https://') });
      if (files.reduce((n, f) => n + f.size, 0) > MAX) problems.push({ el: zone, msg: fileErr.textContent || 'Filerne er for store.' });
      return showErrors(problems);
    };
    const validateStep2 = () => {
      const problems: { el: HTMLElement; msg: string }[] = [];
      form.querySelectorAll<HTMLInputElement>('[required]').forEach((el) => { const m = checkReq(el); if (m) problems.push({ el, msg: m }); });
      return showErrors(problems);
    };

    form.querySelector('[data-next-step]')?.addEventListener('click', () => { if (validateStep1()) showStep(2); });
    form.querySelector('[data-prev-step]')?.addEventListener('click', () => showStep(1));
    form.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && step === 1 && (e.target as HTMLElement).tagName === 'INPUT') { e.preventDefault(); if (validateStep1()) showStep(2); }
    });
    form.addEventListener('qf:reset-step', () => showStep(1, false));
    form.addEventListener('qf:preselect', (e) => {
      const id = (e as CustomEvent<string>).detail;
      const r = form.querySelector<HTMLInputElement>(`input[data-service="${id}"]`);
      if (r) r.checked = true;
    });

    // ---------- Afsendelse ----------
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!validateStep1()) { showStep(1); return; }
      if (!validateStep2()) return;

      const base = document.documentElement.dataset.base || '';
      const thanks = `${location.origin}${base}/tak/`;
      (form.querySelector('[data-next]') as HTMLInputElement).value = thanks;
      (form.querySelector('[data-side]') as HTMLInputElement).value = location.pathname;

      const ydelse = (form.querySelector('input[name="Ydelse"]:checked') as HTMLInputElement | null)?.value || 'ukendt';
      form.classList.add('is-sending');
      (form.querySelector('[data-label]') as HTMLElement).textContent = 'Sender …';

      // Send i baggrunden, så brugeren bliver på siden (ingen hop til formsubmit.co).
      const resetBtn = () => {
        form.classList.remove('is-sending');
        (form.querySelector('[data-label]') as HTMLElement).textContent = 'Send og få fast pris';
      };
      const fail = (msg: string) => { resetBtn(); showErrors([{ el: form.querySelector('[data-submit]') as HTMLElement, msg }]); };
      const fd = new FormData(form);
      fd.delete('attachment');
      files.forEach((file, i) => fd.append(`attachment${i + 1}`, file));
      const action = new URL(form.action, location.href);
      const sameOrigin = action.origin === location.origin;

      try {
        if (sameOrigin) {
          // PHP-maileren på Simply svarer med JSON
          const res = await fetch(action, { method: 'POST', body: fd, headers: { Accept: 'application/json' } });
          const data = await res.json().catch(() => ({}));
          if (!res.ok || data.ok === false) return fail(data.error || 'Forespørgslen blev ikke sendt. Prøv igen, eller skriv til kontakt@procad.dk.');
        } else if (action.hostname.endsWith('formsubmit.co') && files.length === 0) {
          // FormSubmit uden filer: AJAX-endpoint med rigtigt svar
          const res = await fetch(action.href.replace('formsubmit.co/', 'formsubmit.co/ajax/'), { method: 'POST', body: fd, headers: { Accept: 'application/json' } });
          const data = await res.json().catch(() => ({}));
          if (String(data.success) !== 'true') {
            const msg = String(data.message || '');
            return fail(/activat/i.test(msg)
              ? 'Formularen er ikke aktiveret endnu. Ejeren skal klikke på linket i aktiveringsmailen fra FormSubmit.'
              : 'Forespørgslen blev ikke sendt. Prøv igen, eller skriv til kontakt@procad.dk.');
          }
        } else {
          // FormSubmit med filer: AJAX tager ikke vedhæftninger, så send som almindelig formular i baggrunden.
          // Svaret kan ikke læses (cross-origin), men forespørgslen og filerne kommer frem.
          await fetch(action, { method: 'POST', body: fd, mode: 'no-cors' });
        }
        (window as any).dataLayer = (window as any).dataLayer || [];
        (window as any).dataLayer.push({ event: 'generate_lead', form_id: form.id, ydelse, files: files.length });
        try { sessionStorage.setItem('procad-lead', '1'); localStorage.removeItem(draftKey); } catch {}
        location.href = thanks;
      } catch {
        // Netværksfejl i fetch: sidste udvej er almindelig afsendelse (forlader siden)
        try {
          form.querySelectorAll('input[data-generated]').forEach((n) => n.remove());
          files.forEach((file, i) => {
            const dt = new DataTransfer();
            dt.items.add(file);
            const el = document.createElement('input');
            el.type = 'file'; el.name = `attachment${i + 1}`; el.hidden = true; el.dataset.generated = '1';
            el.files = dt.files;
            form.appendChild(el);
          });
          HTMLFormElement.prototype.submit.call(form);
        } catch {
          fail('Forespørgslen blev ikke sendt. Tjek forbindelsen, eller skriv til kontakt@procad.dk.');
        }
      }
    });
  });
</script>
