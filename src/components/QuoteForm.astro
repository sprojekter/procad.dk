---
// Tilbudsformular (v3). Opgaven først, kontaktoplysninger til sidst.
// Sender som almindelig formular (multipart) til site.formEndpoint:
//  - FormSubmit (standard, virker på GitHub Pages): filer op til 10 MB i alt
//  - /api/tilbud.php på Simply.com: filer op til 25 MB i alt
// Spam: honeypot (_honey) + FormSubmit/Turnstile. Ved afsendelse: dataLayer "generate_lead" → /tak/.
import { getCollection } from 'astro:content';
import { site } from '../data/site';

interface Props {
  id?: string;
  compact?: boolean;    // kort version (ydelsessider/landingssider)
  preselect?: string;   // ydelse-id der vælges på forhånd
  heading?: string;
  submitLabel?: string;
}
const { id = 'tilbud', compact = false, preselect = '', heading, submitLabel = 'Send forespørgsel' } = Astro.props;
const services = (await getCollection('ydelser')).sort((a, b) => a.data.order - b.data.order);
const endpoint = site.formEndpoint;
const isFormSubmit = endpoint.includes('formsubmit.co');
const maxMB = isFormSubmit ? 10 : 25;
const accept = '.pdf,.dxf,.dwg,.step,.stp,.iges,.igs,.jpg,.jpeg,.png,.heic,.webp,.zip';
const f = (n: string) => `${id}-${n}`;
const deadlines = ['Hurtigst muligt', 'Inden for en uge', 'Inden for en måned', 'Ingen hast'];
---
<form
  class:list={['qf', { 'qf--compact': compact }]}
  id={id}
  action={endpoint}
  method="post"
  enctype="multipart/form-data"
  novalidate
  data-quote-form
  data-max-mb={maxMB}
>
  {heading && <h2 class="qf__heading">{heading}</h2>}

  <div class="qf__errors" role="alert" aria-live="assertive" tabindex="-1" hidden data-errors></div>

  {compact && preselect ? (
    <input type="hidden" name="Ydelse" value={services.find((s) => s.id === preselect)?.data.navTitle ?? preselect} />
  ) : (
    <fieldset class="qf__set">
      <legend class="qf__legend">Hvad skal du have lavet?</legend>
      <div class="chips" role="radiogroup">
        {services.map((s) => (
          <label class="chip">
            <input type="radio" name="Ydelse" value={s.data.navTitle} checked={s.id === preselect} />
            <span>{s.data.navTitle}</span>
          </label>
        ))}
        <label class="chip"><input type="radio" name="Ydelse" value="Ved ikke endnu" /><span>Ved ikke endnu</span></label>
      </div>
    </fieldset>
  )}

  <div class="field">
    <label for={f('besk')}>Beskriv opgaven <span class="req" aria-hidden="true">*</span></label>
    <textarea class="input" id={f('besk')} name="Beskrivelse" rows={compact ? 3 : 4} required data-msg="Skriv et par linjer om opgaven."
      placeholder="Fx: 40 stk. bukket beslag i 3 mm S235. Har en skitse med mål. Skal bruge DXF til laser."></textarea>
  </div>

  <div class="field">
    <span class="qf__label" id={f('filer-label')}>Filer <span class="hint">valgfrit</span></span>
    <label class="dropzone" for={f('filer')} data-dropzone>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V4m-4.5 4.5L12 4l4.5 4.5M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3"/></svg>
      <span><strong>Træk filer hertil</strong> eller <u>vælg filer</u></span>
      <span class="hint">PDF, DXF, DWG, STEP, IGES, billeder eller ZIP – maks. {maxMB} MB i alt</span>
      <input id={f('filer')} type="file" multiple accept={accept} aria-labelledby={f('filer-label')} data-files />
    </label>
    <ul class="qf__files" data-file-list aria-live="polite"></ul>
    <div class="qf__meter" hidden data-meter><span data-meter-bar></span></div>
    <span class="field-error" data-file-error></span>
  </div>

  {!compact && (
    <fieldset class="qf__set">
      <legend class="qf__legend">Hvornår skal du bruge det? <span class="hint">valgfrit</span></legend>
      <div class="chips chips--sm">
        {deadlines.map((d) => <label class="chip"><input type="radio" name="Tidsplan" value={d} /><span>{d}</span></label>)}
      </div>
    </fieldset>
  )}

  <div class="qf__grid">
    <div class="field">
      <label for={f('navn')}>Navn <span class="req" aria-hidden="true">*</span></label>
      <input class="input" id={f('navn')} name="Navn" type="text" autocomplete="name" required data-msg="Skriv dit navn." />
    </div>
    <div class="field">
      <label for={f('email')}>E-mail <span class="req" aria-hidden="true">*</span></label>
      <input class="input" id={f('email')} name="email" type="email" autocomplete="email" inputmode="email" required data-msg="Skriv en gyldig e-mail, fx navn@firma.dk." />
    </div>
    <div class="field">
      <label for={f('tlf')}>Telefon <span class="hint">valgfrit</span></label>
      <input class="input" id={f('tlf')} name="Telefon" type="tel" autocomplete="tel" inputmode="tel" />
    </div>
    <div class="field">
      <label for={f('firma')}>Firma <span class="hint">valgfrit</span></label>
      <input class="input" id={f('firma')} name="Firma" type="text" autocomplete="organization" />
    </div>
  </div>

  <!-- Spambeskyttelse og opsætning -->
  <input type="text" name="_honey" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
  {isFormSubmit && <input type="hidden" name="_captcha" value="false" />}
  {isFormSubmit && <input type="hidden" name="_template" value="table" />}
  <input type="hidden" name="_subject" value="Ny tilbudsforespørgsel fra procad.dk" />
  <input type="hidden" name="_next" value="" data-next />
  <input type="hidden" name="Side" value={Astro.url.pathname} />
  {site.turnstileSiteKey && <div class="cf-turnstile" data-sitekey={site.turnstileSiteKey} data-language="da"></div>}

  <label class="check qf__consent">
    <input type="checkbox" name="Samtykke" value="Ja" required data-msg="Sæt hak for at sende." />
    <span>ProCAD må bruge mine oplysninger og filer til at besvare forespørgslen. <a href="/privatlivspolitik/" class="qf__policy">Privatlivspolitik</a></span>
  </label>

  <div class="qf__submit">
    <button type="submit" class="btn btn-primary qf__btn" data-submit>
      <span class="qf__spinner" aria-hidden="true"></span>
      <span data-label>{submitLabel}</span>
    </button>
    <p class="hint">Svar inden for {site.responseHours} timer på hverdage. Filerne behandles fortroligt.</p>
  </div>
</form>

{site.turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<style>
  .qf { display: grid; gap: 1.25rem; }
  .qf__heading { font-size: var(--fs-xl); letter-spacing: -0.025em; }
  .qf__set { border: 0; padding: 0; margin: 0; display: grid; gap: .6rem; }
  .qf__legend, .qf__label { font-weight: 500; font-size: var(--fs-sm); color: var(--c-ink); padding: 0; }
  .req { color: var(--c-orange); }
  .qf__grid { display: grid; gap: 1rem; }
  @media (min-width: 40rem) { .qf__grid { grid-template-columns: 1fr 1fr; } }
  .qf--compact .qf__grid { grid-template-columns: 1fr 1fr; }
  @media (max-width: 30rem) { .qf--compact .qf__grid { grid-template-columns: 1fr; } }

  .chips { display: flex; flex-wrap: wrap; gap: .5rem; }
  .chip { position: relative; }
  .chip input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .chip span { display: inline-flex; align-items: center; min-height: 2.5rem; padding: .45rem .95rem; border: 1px solid var(--c-field); border-radius: 999px; font-size: .9375rem; color: var(--c-ink); background: var(--c-white); transition: border-color .15s ease, background-color .15s ease, color .15s ease; cursor: pointer; }
  .chips--sm .chip span { min-height: 2.25rem; font-size: .875rem; padding: .35rem .85rem; }
  .chip:hover span { border-color: var(--c-ink); }
  .chip input:checked + span { background: var(--c-ink); color: var(--c-on-ink); border-color: var(--c-ink); }
  .chip input:focus-visible + span { box-shadow: var(--ring); }

  .qf__files { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .4rem; }
  .qf__files:empty { display: none; }
  .qf__files li { display: inline-flex; align-items: center; gap: .4rem; max-width: 100%; padding: .3rem .35rem .3rem .7rem; border: 1px solid var(--c-line); background: var(--c-paper); border-radius: 999px; font-size: var(--fs-xs); color: var(--c-ink); }
  .qf__files li span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 14rem; }
  .qf__files li small { color: var(--c-muted); }
  .qf__files button { display: grid; place-items: center; width: 1.5rem; height: 1.5rem; border-radius: 50%; border: 0; background: transparent; color: var(--c-muted); cursor: pointer; }
  .qf__files button:hover { background: var(--c-line); color: var(--c-ink); }
  .qf__meter { height: 4px; background: var(--c-line); border-radius: 99px; overflow: hidden; }
  .qf__meter span { display: block; height: 100%; width: 0; background: var(--c-ink); transition: width .3s var(--ease); }
  .qf__meter.is-over span { background: var(--c-danger); }

  .qf__errors { padding: .85rem 1rem; border-radius: var(--r-md); border: 1px solid color-mix(in srgb, var(--c-danger) 40%, transparent); background: color-mix(in srgb, var(--c-danger) 8%, var(--c-white)); font-size: var(--fs-sm); color: var(--c-ink); }
  .qf__errors ul { margin: .35rem 0 0; padding-left: 1.1rem; }
  .qf__errors a { color: var(--c-ink); }
  .qf__consent { color: var(--c-muted); }
  .qf__policy { color: var(--c-ink); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--c-line-strong); }
  .qf__submit { display: grid; gap: .6rem; justify-items: start; }
  .qf__btn { min-width: 13rem; }
  .qf--compact .qf__btn { width: 100%; }
  .qf__spinner { display: none; width: 1rem; height: 1rem; border-radius: 50%; border: 2px solid currentColor; border-right-color: transparent; animation: qf-spin .7s linear infinite; }
  .qf.is-sending .qf__spinner { display: inline-block; }
  .qf.is-sending .qf__btn { pointer-events: none; opacity: .85; }
  @keyframes qf-spin { to { transform: rotate(360deg); } }
  .field-error:empty { display: none; }
</style>

<script>
  const OK_EXT = ['pdf', 'dxf', 'dwg', 'step', 'stp', 'iges', 'igs', 'jpg', 'jpeg', 'png', 'heic', 'webp', 'zip'];
  const fmt = (b: number) => (b >= 1048576 ? `${(b / 1048576).toFixed(1).replace('.', ',')} MB` : `${Math.max(1, Math.round(b / 1024))} kB`);

  document.querySelectorAll<HTMLFormElement>('[data-quote-form]').forEach((form) => {
    const MAX = Number(form.dataset.maxMb || 10) * 1048576;
    const input = form.querySelector<HTMLInputElement>('[data-files]')!;
    const list = form.querySelector<HTMLUListElement>('[data-file-list]')!;
    const fileErr = form.querySelector<HTMLElement>('[data-file-error]')!;
    const meter = form.querySelector<HTMLElement>('[data-meter]')!;
    const bar = form.querySelector<HTMLElement>('[data-meter-bar]')!;
    const zone = form.querySelector<HTMLElement>('[data-dropzone]')!;
    const errors = form.querySelector<HTMLElement>('[data-errors]')!;
    const draftKey = `procad-draft-${form.id}`;
    let files: File[] = [];

    // ---------- Filer: tilføj, vis som chips, fjern ----------
    const renderFiles = () => {
      list.innerHTML = '';
      let total = 0;
      files.forEach((file, i) => {
        total += file.size;
        const li = document.createElement('li');
        li.innerHTML = `<span></span><small>${fmt(file.size)}</small><button type="button" aria-label="Fjern ${file.name.replace(/"/g, '')}"><svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 2l8 8M10 2l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></button>`;
        (li.querySelector('span') as HTMLElement).textContent = file.name;
        li.querySelector('button')!.addEventListener('click', () => { files.splice(i, 1); renderFiles(); });
        list.appendChild(li);
      });
      meter.hidden = files.length === 0;
      bar.style.width = `${Math.min(100, (total / MAX) * 100)}%`;
      meter.classList.toggle('is-over', total > MAX);
      fileErr.textContent = total > MAX ? `Filerne fylder ${fmt(total)} – maks. ${fmt(MAX)}. Fjern en fil, eller indsæt et WeTransfer-link i beskrivelsen.` : '';
    };
    const addFiles = (incoming: FileList | File[]) => {
      const bad: string[] = [];
      Array.from(incoming).forEach((file) => {
        const ext = file.name.split('.').pop()?.toLowerCase() || '';
        if (!OK_EXT.includes(ext)) { bad.push(file.name); return; }
        if (!files.some((f) => f.name === file.name && f.size === file.size)) files.push(file);
      });
      renderFiles();
      if (bad.length) fileErr.textContent = `${bad.join(', ')} kan ikke sendes. Pak filen i en ZIP, eller send den på mail.`;
    };
    input.addEventListener('change', () => { addFiles(input.files || []); input.value = ''; });
    ['dragenter', 'dragover'].forEach((t) => zone.addEventListener(t, (e) => { e.preventDefault(); zone.classList.add('is-dragover'); }));
    ['dragleave', 'drop'].forEach((t) => zone.addEventListener(t, () => zone.classList.remove('is-dragover')));
    zone.addEventListener('drop', (e) => { e.preventDefault(); if ((e as DragEvent).dataTransfer?.files) addFiles((e as DragEvent).dataTransfer!.files); });

    // ---------- Kladde: gem tekstfelter lokalt ----------
    const fields = () => Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input[type=text], input[type=email], input[type=tel], textarea, input[type=radio]'));
    try {
      const d = JSON.parse(localStorage.getItem(draftKey) || '{}');
      fields().forEach((el) => {
        if (el.name.startsWith('_') || !(el.name in d)) return;
        if (el.type === 'radio') (el as HTMLInputElement).checked = d[el.name] === el.value;
        else el.value = d[el.name];
      });
    } catch {}
    let t: number | undefined;
    form.addEventListener('input', () => {
      clearTimeout(t);
      t = window.setTimeout(() => {
        const d: Record<string, string> = {};
        new FormData(form).forEach((v, k) => { if (typeof v === 'string' && !k.startsWith('_') && k !== 'Samtykke' && k !== 'Side') d[k] = v; });
        try { localStorage.setItem(draftKey, JSON.stringify(d)); } catch {}
      }, 400);
    });

    // ---------- Validering ----------
    const fieldError = (el: HTMLInputElement | HTMLTextAreaElement) => {
      const ok = el.type === 'checkbox' ? (el as HTMLInputElement).checked : el.value.trim() !== '' && el.checkValidity();
      const msg = ok ? '' : el.dataset.msg || 'Udfyld feltet.';
      el.setAttribute('aria-invalid', String(!ok));
      let err = document.getElementById(`${el.id || el.name}-err`);
      if (!err) {
        err = document.createElement('span');
        err.id = `${el.id || el.name}-err`;
        err.className = 'field-error';
        (el.type === 'checkbox' ? el.closest('label')! : el).insertAdjacentElement('afterend', err);
        el.setAttribute('aria-describedby', err.id);
      }
      err.textContent = msg;
      return msg;
    };
    const required = () => Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]'));
    required().forEach((el) => {
      el.addEventListener('blur', () => { if (el.dataset.touched || el.value) { el.dataset.touched = '1'; fieldError(el); } });
      el.addEventListener('input', () => { if (el.getAttribute('aria-invalid') === 'true') fieldError(el); });
      el.addEventListener('change', () => { if (el.type === 'checkbox') fieldError(el); });
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const problems: { el: HTMLElement; msg: string }[] = [];
      required().forEach((el) => { const m = fieldError(el); if (m) problems.push({ el, msg: m }); });
      const total = files.reduce((n, f) => n + f.size, 0);
      if (total > MAX) problems.push({ el: input, msg: fileErr.textContent || 'Filerne er for store.' });

      if (problems.length) {
        errors.hidden = false;
        errors.innerHTML = `<strong>Ret ${problems.length === 1 ? 'dette' : 'disse ' + problems.length + ' ting'}, før du sender:</strong><ul></ul>`;
        const ul = errors.querySelector('ul')!;
        problems.forEach((p) => {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = `#${p.el.id}`; a.textContent = p.msg;
          a.addEventListener('click', (ev) => { ev.preventDefault(); p.el.focus(); });
          li.appendChild(a); ul.appendChild(li);
        });
        errors.focus();
        return;
      }
      errors.hidden = true;

      // Filer: én input pr. fil (attachment1, attachment2 …) – virker med FormSubmit og PHP
      form.querySelectorAll('input[data-generated]').forEach((n) => n.remove());
      files.forEach((file, i) => {
        const dt = new DataTransfer();
        dt.items.add(file);
        const el = document.createElement('input');
        el.type = 'file'; el.name = `attachment${i + 1}`; el.hidden = true; el.dataset.generated = '1';
        el.files = dt.files;
        form.appendChild(el);
      });

      // Videre til takkesiden efter afsendelse
      const base = document.documentElement.dataset.base || '';
      (form.querySelector('[data-next]') as HTMLInputElement).value = `${location.origin}${base}/tak/`;

      const ydelse = (form.querySelector('input[name="Ydelse"]:checked, input[type=hidden][name="Ydelse"]') as HTMLInputElement | null)?.value || 'ukendt';
      (window as any).dataLayer = (window as any).dataLayer || [];
      (window as any).dataLayer.push({ event: 'generate_lead', form_id: form.id, ydelse, files: files.length });
      try { sessionStorage.setItem('procad-lead', '1'); localStorage.removeItem(draftKey); } catch {}

      form.classList.add('is-sending');
      (form.querySelector('[data-label]') as HTMLElement).textContent = 'Sender …';
      HTMLFormElement.prototype.submit.call(form);
    });
  });
</script>
