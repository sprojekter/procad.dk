---
// Mobil: fast handlingsbjælke i tommelfingerzonen – Menu, Ring og Send fil (lige synlige).
// Menu åbner et ark med navigation, tema og kontakt. Skjules, når en indlejret formular er i syne.
import { getCollection } from 'astro:content';
import { site, mainNav } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';
const services = (await getCollection('ydelser')).sort((a, b) => a.data.order - b.data.order);
const path = Astro.url.pathname;
---
<nav class="dock" aria-label="Hurtige handlinger" data-dock>
  <button type="button" class="dock__menu" aria-haspopup="dialog" aria-controls="menu-sheet" data-open-menu>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10"/></svg>
    <span>Menu</span>
  </button>
  <a href={site.phoneHref} class="btn btn-secondary dock__btn">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>
    Ring
  </a>
  <a href="/kontakt/" class="btn btn-primary dock__btn dock__send" data-open-quote>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V4m-4.5 4.5L12 4l4.5 4.5M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3"/></svg>
    Send fil
  </a>
</nav>

<dialog class="ms" id="menu-sheet" aria-label="Menu">
  <div class="ms__inner">
    <div class="ms__head">
      <span class="ms__grip" aria-hidden="true"></span>
      <strong>Menu</strong>
      <button type="button" class="ms__close" data-close-menu aria-label="Luk menu">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </div>
    <p class="ms__group">Ydelser</p>
    <ul class="ms__list">
      {services.map((s) => <li><a href={`/ydelser/${s.id}/`} aria-current={path.startsWith(`/ydelser/${s.id}`) ? 'page' : undefined}>{s.data.navTitle}<span>{s.data.navDescription}</span></a></li>)}
    </ul>
    <p class="ms__group">ProCAD</p>
    <ul class="ms__list ms__list--2">
      <li><a href="/">Forside</a></li>
      {mainNav.map((i) => <li><a href={i.href} aria-current={path.startsWith(i.href) ? 'page' : undefined}>{i.label}</a></li>)}
    </ul>
    <div class="ms__row">
      <span>Mørkt tema</span>
      <ThemeToggle />
    </div>
    <div class="ms__contact">
      <a href={site.phoneHref}>{site.phone}</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </div>
</dialog>

<style>
  .dock { position: fixed; z-index: 45; left: 0; right: 0; bottom: 0; display: grid; grid-template-columns: 3.25rem 1fr 1fr; gap: .5rem; padding: .5rem .75rem calc(.5rem + env(safe-area-inset-bottom)); background: var(--c-header); backdrop-filter: saturate(180%) blur(16px); -webkit-backdrop-filter: saturate(180%) blur(16px); border-top: 1px solid var(--c-line); transition: transform .3s var(--ease); }
  /* Når en indlejret formular er synlig, skjules kun "Send fil" – Menu og Ring bliver */
  .dock.has-form { grid-template-columns: 3.25rem 1fr; }
  .dock.has-form .dock__send { display: none; }
  .dock__menu { display: grid; place-items: center; gap: 0; min-height: 3rem; border: 0; background: transparent; color: var(--c-ink); font: 500 .75rem var(--font-sans); cursor: pointer; border-radius: var(--r-md); }
  .dock__btn { min-height: 3rem; }
  @media (min-width: 64rem) { .dock { display: none; } }

  .ms { padding: 0; border: 0; margin: 0; width: 100%; max-width: none; height: 100%; max-height: none; background: transparent; color: var(--c-body); }
  .ms::backdrop { background: rgba(8, 8, 10, .5); }
  .ms__inner { position: absolute; left: 0; right: 0; bottom: 0; max-height: 88dvh; overflow-y: auto; background: var(--c-white); border-radius: var(--r-xl) var(--r-xl) 0 0; padding: 0 1.25rem calc(1.25rem + env(safe-area-inset-bottom)); }
  .ms[open] .ms__inner { animation: ms-up .3s var(--ease); }
  @keyframes ms-up { from { transform: translateY(40px); opacity: 0; } to { transform: none; opacity: 1; } }
  .ms__head { position: sticky; top: 0; display: flex; justify-content: space-between; align-items: center; padding: 1.1rem 0 .5rem; background: var(--c-white); color: var(--c-ink); font-size: var(--fs-lg); }
  .ms__grip { position: absolute; left: 50%; top: .4rem; width: 2.5rem; height: 4px; border-radius: 4px; background: var(--c-line-strong); transform: translateX(-50%); }
  .ms__close { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 50%; border: 1px solid var(--c-line); background: var(--c-paper); color: var(--c-ink); }
  .ms__group { margin: 1rem 0 .25rem; font-size: var(--fs-xs); color: var(--c-muted); font-weight: 500; }
  .ms__list { list-style: none; padding: 0; margin: 0; display: grid; }
  .ms__list a { display: grid; min-height: 3.25rem; align-content: center; padding: .5rem 0; border-bottom: 1px solid var(--c-line); text-decoration: none; color: var(--c-ink); font-size: 1.0625rem; font-weight: 500; }
  .ms__list a span { font-size: var(--fs-xs); color: var(--c-muted); font-weight: 400; }
  /* Aktiv side: vægt + orange streg – ikke kun farve, og ingen orange tekst (kontrast) */
  .ms__list a[aria-current="page"] { font-weight: 650; box-shadow: inset 3px 0 0 var(--c-orange); padding-left: .85rem; }
  .ms__list--2 { grid-template-columns: 1fr 1fr; column-gap: 1rem; }
  .ms__row { display: flex; justify-content: space-between; align-items: center; min-height: 3.25rem; margin-top: .75rem; border-bottom: 1px solid var(--c-line); color: var(--c-ink); font-weight: 500; }
  .ms__contact { display: grid; gap: .25rem; margin-top: 1rem; }
  .ms__contact a { display: flex; align-items: center; min-height: 2.75rem; color: var(--c-ink); text-decoration: none; }
</style>

<script>
  const dock = document.querySelector<HTMLElement>('[data-dock]');
  const sheet = document.getElementById('menu-sheet') as HTMLDialogElement | null;
  if (dock) {
    // Skjul når en indlejret formular (ikke dialogen) er synlig
    const visible = new Set<Element>();
    const io = new IntersectionObserver((es) => {
      es.forEach((e) => (e.isIntersecting ? visible.add(e.target) : visible.delete(e.target)));
      dock.classList.toggle('has-form', visible.size > 0);
    }, { threshold: 0.15 });
    document.querySelectorAll('[data-quote-form]:not([data-dialog])').forEach((f) => io.observe(f));
  }
  if (sheet && typeof sheet.showModal === 'function') {
    document.querySelector('[data-open-menu]')?.addEventListener('click', () => { sheet.showModal(); history.pushState({ menuSheet: true }, ''); });
    const close = (fromHistory = false) => { if (!sheet.open) return; sheet.close(); if (!fromHistory && history.state?.menuSheet) history.back(); };
    sheet.querySelector('[data-close-menu]')?.addEventListener('click', () => close());
    sheet.addEventListener('cancel', (e) => { e.preventDefault(); close(); });
    sheet.addEventListener('click', (e) => { if (e.target === sheet) close(); });
    window.addEventListener('popstate', () => close(true));
    // Links i arket: luk arket OG fjern dets historik-post, før der navigeres (ellers skal man trykke tilbage to gange)
    sheet.querySelectorAll<HTMLAnchorElement>('a').forEach((a) => a.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey) return;
      const external = a.protocol === 'tel:' || a.protocol === 'mailto:';
      if (!history.state?.menuSheet) { sheet.close(); return; }
      if (external) { close(); return; } // standardhandlingen (opkald/mail) kører stadig
      e.preventDefault();
      sheet.close();
      window.addEventListener('popstate', () => { location.href = a.href; }, { once: true });
      history.back();
    }));
  }
</script>
