---
// Sekskant-badge (logoets formsprog). Brug `label` til tal/bogstav eller `icon` til et lille ikon.
interface Props { label?: string; icon?: 'upload' | 'clock' | 'chat' | 'price' | 'check' | 'file' | 'lock' | 'cad'; size?: number; tone?: 'light' | 'dark' | 'orange' }
const { label, icon, size = 48, tone = 'light' } = Astro.props;
const fill = tone === 'orange' ? '#FF7621' : tone === 'dark' ? '#111' : '#fff';
const stroke = tone === 'dark' ? '#fff' : '#000';
const ink = tone === 'dark' ? '#fff' : '#000';
const icons: Record<string, string> = {
  upload: 'M24 31V17m-6 5l6-6 6 6M16 33h16',
  clock: 'M24 15a9 9 0 1 0 0 18a9 9 0 1 0 0-18zM24 19v5.5l3.5 2.5',
  chat: 'M15 17h18v11H22l-5 4v-4h-2z',
  price: 'M16 16h10l7 8-8 8-9-8zM20.5 20.5h.01',
  check: 'M16.5 24.5l5 5 10-11',
  file: 'M18 14h8l5 5v15H18zM26 14v5h5',
  lock: 'M17 23h14v10H17zM20 23v-3a4 4 0 0 1 8 0v3',
  cad: 'M15 33l18-18M15 33h6M15 33v-6M27 15h6v6',
};
---
<svg width={size} height={size} viewBox="0 0 48 48" aria-hidden="true" class="hexicon">
  <path d="M14 3h20l11 21-11 21H14L3 24z" fill={fill} stroke={stroke} stroke-width="2.5" />
  {label && <text x="24" y="30" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-weight="500" font-size="16" fill={ink}>{label}</text>}
  {icon && <path d={icons[icon]} fill="none" stroke={ink} stroke-width="2.2" stroke-linecap="square" stroke-linejoin="miter" />}
</svg>
