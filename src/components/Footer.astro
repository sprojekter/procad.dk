---
import { getCollection } from 'astro:content';
import Logo from './Logo.astro';
import { site } from '../data/site';
const services = (await getCollection('ydelser')).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();
---
<footer class="ftr">
  <div class="wrap ftr__grid">
    <div class="ftr__brand">
      <Logo />
      <p class="ftr__tagline">{site.tagline}</p>
      <p class="muted ftr__desc">CAD-tegninger og teknisk dokumentation til metalbearbejdning. Tegnet i Danmark efter DS/EN ISO.</p>
    </div>
    <nav aria-label="Ydelser" class="ftr__nav">
      <h2 class="ftr__h">Ydelser</h2>
      <ul>
        {services.map((s) => <li><a href={`/ydelser/${s.id}/`}>{s.data.navTitle}</a></li>)}
        <li><a href="/priser/">Priser</a></li>
      </ul>
    </nav>
    <nav aria-label="ProCAD" class="ftr__nav">
      <h2 class="ftr__h">ProCAD</h2>
      <ul>
        <li><a href="/cases/">Cases</a></li>
        <li><a href="/proces/">Sådan arbejder jeg</a></li>
        <li><a href="/om/">Om ProCAD</a></li>
        <li><a href="/faq/">Spørgsmål og svar</a></li>
      </ul>
    </nav>
    <div>
      <h2 class="ftr__h">Kontakt</h2>
      <ul>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={site.phoneHref}>{site.phone}</a></li>
        <li class="muted">CVR {site.cvr}</li>
      </ul>
    </div>
  </div>
  <div class="wrap ftr__bottom">
    <p>© {year} ProCAD</p>
    <ul>
      <li><a href="/privatlivspolitik/">Privatlivspolitik</a></li>
      <li><a href="/cookiepolitik/">Cookiepolitik</a></li>
      <li><button type="button" class="ftr__cookie" data-cookie-settings>Cookie-indstillinger</button></li>
    </ul>
  </div>
</footer>

<style>
  /* Mobil: navigation ligger i menu-arket i bunden, så footeren viser kun kontakt + jura (mindre scroll) */
  .ftr__nav { display: none; }
  @media (min-width: 48rem) { .ftr__nav { display: block; } }
  @media (max-width: 47.99rem) {
    .ftr { padding-block: 2.5rem 1.5rem; }
    .ftr__desc { display: none; }
    .ftr ul { gap: 0; }
    .ftr li > a, .ftr__cookie { display: inline-flex; align-items: center; min-height: 2.75rem; }
    .ftr__bottom { margin-top: 1.5rem; }
    .ftr__bottom ul { gap: 0 1.25rem; }
  }
  .ftr { padding-block: 4.5rem 2rem; border-top: 1px solid var(--c-line); background: var(--c-paper); font-size: var(--fs-sm); }
  .ftr__grid { display: grid; gap: 2.5rem; }
  @media (min-width: 48rem) { .ftr__grid { grid-template-columns: 1.6fr 1fr 1fr 1.1fr; } }
  .ftr__brand :global(svg) { height: 26px; width: auto; }
  .ftr__tagline { margin-top: 1.25rem; font-weight: 500; color: var(--c-ink); }
  .ftr__desc { margin-top: .35rem; max-width: 30ch; }
  .ftr__h { font-size: var(--fs-sm); font-weight: 500; color: var(--c-ink); letter-spacing: 0; margin-bottom: .9rem; }
  .ftr ul { list-style: none; padding: 0; margin: 0; display: grid; gap: .6rem; }
  .ftr a { color: var(--c-muted); text-decoration: none; transition: color .15s ease; }
  .ftr a:hover { color: var(--c-ink); }
  .ftr__bottom { margin-top: 3.5rem; padding-top: 1.5rem; border-top: 1px solid var(--c-line); display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; color: var(--c-muted); }
  .ftr__bottom ul { display: flex; flex-wrap: wrap; gap: 1.5rem; }
  .ftr__cookie { background: none; border: 0; padding: 0; color: var(--c-muted); font: inherit; cursor: pointer; }
  .ftr__cookie:hover { color: var(--c-ink); }
</style>
