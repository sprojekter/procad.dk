---
// Fast "Få tilbud"-bjælke nederst på mobil. Vises efter lidt scroll og skjules,
// når en tilbudsformular er synlig (eller på /kontakt/).
import { site } from '../data/site';
const onContact = Astro.url.pathname.startsWith('/kontakt');
---
{!onContact && (
  <div class="mcta" data-mcta aria-hidden="true">
    <a href="/kontakt/" class="btn btn-primary mcta__main" tabindex="-1">Få et tilbud</a>
    <a href={site.phoneHref} class="btn btn-secondary mcta__call" aria-label="Ring til ProCAD" tabindex="-1">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>
    </a>
  </div>
)}

<style>
  .mcta { position: fixed; z-index: 40; left: .75rem; right: .75rem; bottom: .75rem; display: flex; gap: .5rem; padding: .5rem; border-radius: 16px; background: var(--c-header); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid var(--c-line); box-shadow: var(--shadow-lg); transform: translateY(140%); transition: transform .35s var(--ease); }
  .mcta.is-visible { transform: none; }
  .mcta__main { flex: 1; }
  .mcta__call { width: 2.875rem; padding: 0; }
  @media (min-width: 64rem) { .mcta { display: none; } }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-mcta]');
  if (bar) {
    const visible = new Set<Element>();
    const update = () => {
      const show = window.scrollY > 500 && visible.size === 0;
      bar.classList.toggle('is-visible', show);
      bar.setAttribute('aria-hidden', String(!show));
      bar.querySelectorAll('a').forEach((a) => a.setAttribute('tabindex', show ? '0' : '-1'));
    };
    const io = new IntersectionObserver((es) => {
      es.forEach((e) => (e.isIntersecting ? visible.add(e.target) : visible.delete(e.target)));
      update();
    });
    document.querySelectorAll('[data-quote-form], .cta, footer').forEach((f) => io.observe(f));
    window.addEventListener('scroll', update, { passive: true });
    update();
  }
</script>
