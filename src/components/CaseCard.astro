---
import type { CollectionEntry } from 'astro:content';
import Media from './Media.astro';
interface Props { entry: CollectionEntry<'cases'>; headingLevel?: 'h2' | 'h3' }
const { entry, headingLevel = 'h3' } = Astro.props;
const d = entry.data;
const H = headingLevel;
---
<article class="cc card card--hover">
  <a href={`/cases/${entry.id}/`} class="cc__link">
    <div class="cc__pair">
      <div class="cc__half">
        <Media src={d.before.src} alt={d.before.alt} ratio="1 / 1" />
        <span class="cc__tag">Før</span>
      </div>
      <div class="cc__half">
        <Media src={d.after.src} alt={d.after.alt} ratio="1 / 1" />
        <span class="cc__tag cc__tag--after">Efter</span>
      </div>
    </div>
    <div class="cc__body">
      <p class="cc__meta">{d.industry}{d.example && ' (eksempel)'}</p>
      <H class="cc__title">{d.title}</H>
      <p class="cc__sum">{d.summary}</p>
      <span class="link">Læs casen</span>
    </div>
  </a>
</article>

<style>
  .cc { overflow: hidden; }
  .cc__link { display: grid; text-decoration: none; color: inherit; height: 100%; }
  .cc__pair { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; padding: 6px 6px 0; }
  .cc__half { position: relative; }
  .cc__half :global(.ph) { border-radius: 14px; }
  .cc__half :global(.ph__label) { display: none; }
  .cc__tag { position: absolute; top: .6rem; left: .6rem; background: rgba(255,255,255,.9); backdrop-filter: blur(6px); border-radius: 999px; padding: .15rem .6rem; font-size: var(--fs-xs); font-weight: 500; color: var(--c-ink); }
  .cc__tag--after { background: var(--c-ink); color: #fff; }
  .cc__body { padding: 1.4rem 1.5rem 1.6rem; display: grid; gap: .5rem; align-content: start; }
  .cc__meta { font-size: var(--fs-xs); color: var(--c-muted); }
  .cc__title { font-size: var(--fs-lg); }
  .cc__sum { font-size: var(--fs-sm); color: var(--c-muted); }
  .cc .link { margin-top: .4rem; font-size: var(--fs-sm); }
</style>
