---
// Billede eller pladsholder.
// - Lokale billeder i public/ (fx /images/ydelser/arbejdstegninger.webp). Findes en "-800"-version
//   ved siden af, bruges den til små skærme.
// - Findes filen ikke ved build, vises en pladsholder med specifikationen (aldrig et ødelagt billede).
import { existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  src?: string;
  alt: string;
  spec?: string;
  motif?: string;
  ratio?: string;    // CSS aspect-ratio, fx "16 / 10"
  eager?: boolean;
  sizes?: string;
  class?: string;
}
const { src, alt, spec, motif, ratio = '4 / 3', eager = false, sizes = '(min-width: 64rem) 33vw, 100vw', class: cls = '' } = Astro.props;
const pub = (p: string) => join(process.cwd(), 'public', p); // build køres fra projektroden
const exists = !!src && src.startsWith('/') && existsSync(pub(src));
const small = exists ? src!.replace(/(\.\w+)$/, '-800$1') : '';
const hasSmall = exists && existsSync(pub(small));
const [rw, rh] = ratio.split('/').map((n) => parseFloat(n));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
{exists ? (
  <img
    class:list={['media', cls]}
    src={base + src}
    srcset={hasSmall ? `${base + small} 800w, ${base + src} 1600w` : undefined}
    sizes={hasSmall ? sizes : undefined}
    alt={alt}
    width={1600}
    height={Math.round((1600 * rh) / rw)}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    style={`aspect-ratio:${ratio}`}
  />
) : (
  <div class:list={['ph', cls]} style={`aspect-ratio:${ratio}`} role="img" aria-label={`Pladsholder: ${alt}`}>
    <div class="ph__label">
      <strong>[UDFYLD] Billede: {alt}</strong>
      {spec && <span>Format: {spec}</span>}
      {motif && <><br /><span>Motiv: {motif}</span></>}
    </div>
  </div>
)}

<style>
  .media { display: block; width: 100%; height: auto; object-fit: cover; border-radius: var(--r-lg); background: var(--c-ph-a); }
</style>
