---
// Billede eller pladsholder.
// - Lokale billeder: læg fx /public/images/cases/beslag-foer.jpg, kør `npm run images`
//   (laver .avif og .webp ved siden af) og angiv src="/images/cases/beslag-foer.jpg".
// - Unsplash-URL'er (images.unsplash.com) får automatisk srcset i AVIF/WebP via deres CDN.
// - Uden src vises en pladsholder med specifikationen.
interface Props {
  src?: string;
  alt: string;
  spec?: string;
  motif?: string;
  ratio?: string;    // CSS aspect-ratio, fx "16 / 10"
  eager?: boolean;
  sizes?: string;
  class?: string;
}
const { src, alt, spec, motif, ratio = '4 / 3', eager = false, sizes = '(min-width: 64rem) 33vw, 100vw', class: cls = '' } = Astro.props;
const remote = !!src && /^https:\/\/images\.unsplash\.com\//.test(src);
const [rw, rh] = ratio.split('/').map((n) => parseFloat(n));
const u = (w: number) => `${src}?auto=format&fit=crop&q=70&w=${w}&h=${Math.round((w * rh) / rw)}`;
const base = src?.replace(/\.(jpe?g|png)$/i, '');
---
{remote ? (
  <img
    class:list={['media', cls]}
    src={u(1200)}
    srcset={[480, 800, 1200, 1600].map((w) => `${u(w)} ${w}w`).join(', ')}
    sizes={sizes}
    alt={alt}
    width={1200}
    height={Math.round((1200 * rh) / rw)}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    style={`aspect-ratio:${ratio}`}
  />
) : src ? (
  <picture class={cls}>
    <source srcset={`${base}.avif`} type="image/avif" />
    <source srcset={`${base}.webp`} type="image/webp" />
    <img class="media" src={src} alt={alt} width={1200} height={Math.round((1200 * rh) / rw)} loading={eager ? 'eager' : 'lazy'} decoding="async" style={`aspect-ratio:${ratio}`} />
  </picture>
) : (
  <div class:list={['ph', cls]} style={`aspect-ratio:${ratio}`} role="img" aria-label={`Pladsholder: ${alt}`}>
    <div class="ph__label">
      <strong>[UDFYLD] Billede: {alt}</strong>
      {spec && <span>Format: {spec}</span>}
      {motif && <><br /><span>Motiv: {motif}</span></>}
    </div>
  </div>
)}

<style>
  .media { display: block; width: 100%; height: auto; object-fit: cover; border-radius: var(--r-lg); background: var(--c-ph-a); }
</style>
