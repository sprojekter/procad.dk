---
// Billede eller pladsholder.
// Når der er et rigtigt billede: læg fx /public/images/cases/beslag-foer.jpg og kør `npm run images`
// (laver .avif og .webp ved siden af). Angiv så src="/images/cases/beslag-foer.jpg".
// Uden src vises en pladsholder med specifikationen, så ejeren kan se, hvad der mangler.
interface Props {
  src?: string;
  alt: string;
  spec?: string;     // fx "16:9, 1600×900, JPG"
  motif?: string;    // hvad billedet skal vise
  ratio?: string;    // CSS aspect-ratio, fx "16 / 9"
  eager?: boolean;
  width?: number;
  height?: number;
  class?: string;
}
const { src, alt, spec, motif, ratio = '4 / 3', eager = false, width = 1600, height = 1200, class: cls = '' } = Astro.props;
const base = src?.replace(/\.(jpe?g|png)$/i, '');
---
{src ? (
  <picture class={cls}>
    <source srcset={`${base}.avif`} type="image/avif" />
    <source srcset={`${base}.webp`} type="image/webp" />
    <img src={src} alt={alt} width={width} height={height} loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : 'auto'} style={`aspect-ratio:${ratio};object-fit:cover;width:100%`} />
  </picture>
) : (
  <div class:list={['ph', cls]} style={`aspect-ratio:${ratio}`} role="img" aria-label={`Pladsholder: ${alt}`}>
    <div class="ph__label">
      <strong>[UDFYLD] Billede: {alt}</strong>
      {spec && <span>Format: {spec}</span>}
      {motif && <><br /><span>Motiv: {motif}</span></>}
    </div>
  </div>
)}
