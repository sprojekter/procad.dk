---
// Billede eller pladsholder.
// - Lokale billeder i public/ (fx /images/ydelser/arbejdstegninger.webp). Findes en "-800"-version
//   ved siden af, bruges den til små skærme.
// - Findes filen ikke ved build, vises en pladsholder med specifikationen (aldrig et ødelagt billede).
import { existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  src?: string;
  alt: string;
  spec?: string;
  motif?: string;
  ratio?: string;    // CSS aspect-ratio, fx "16 / 10"
  eager?: boolean;
  priority?: boolean;  // sidens vigtigste billede (LCP): hentes straks og med høj prioritet
  decorative?: boolean; // inde i et link med egen tekst: tom alt, så skærmlæsere ikke læser det to gange
  sizes?: string;
  class?: string;
}
const { src, alt, spec, motif, ratio = '4 / 3', eager = false, priority = false, decorative = false, sizes = '(min-width: 64rem) 33vw, 100vw', class: cls = '' } = Astro.props;
const pub = (p: string) => join(process.cwd(), 'public', p); // build køres fra projektroden
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const exists = !!src && src.startsWith('/') && existsSync(pub(src));
const [rw, rh] = ratio.split('/').map((n) => parseFloat(n));
// fetch-photos gemmer stående billeder 25 % smallere (1200/600/300 px) – srcset skal angive de rigtige bredder
const k = rh / rw > 1 ? 0.75 : 1;
const variant = (suffix: string) => (exists ? src!.replace(/(\.\w+)$/, `${suffix}$1`) : '');
const sources = [
  ['-400', 400], ['-800', 800], ['', 1600],
].filter(([suf]) => suf === '' || (exists && existsSync(pub(variant(suf as string)))))
 .map(([suf, w]) => `${base + variant(suf as string)} ${Math.round((w as number) * k)}w`);
---
{exists ? (
  <img
    class:list={['media', cls]}
    src={base + src}
    srcset={sources.length > 1 ? sources.join(', ') : undefined}
    sizes={sources.length > 1 ? sizes : undefined}
    alt={decorative ? '' : alt}
    width={Math.round(1600 * k)}
    height={Math.round((1600 * k * rh) / rw)}
    loading={eager || priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
    decoding="async"
    style={`aspect-ratio:${ratio}`}
  />
) : (
  <div class:list={['ph', cls]} style={`aspect-ratio:${ratio}`} role="img" aria-label={`Pladsholder: ${alt}`}>
    <div class="ph__label">
      <strong>[UDFYLD] Billede: {alt}</strong>
      {spec && <span>Format: {spec}</span>}
      {motif && <><br /><span>Motiv: {motif}</span></>}
    </div>
  </div>
)}

<style>
  .media { display: block; width: 100%; height: auto; object-fit: cover; border-radius: var(--r-lg); background: var(--c-ph-a); }
</style>
