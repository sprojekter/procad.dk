---
// Animeret arbejdstegning af et bukket beslag: sidebillede, udfoldning med bukkelinje,
// målsætning og tegningshoved. Tegnes op én gang ved sideindlæsning (respekterer reduced motion).
// Kan senere erstattes af hero-videoen (se docs/04-billeder-og-video.md).
---
<figure class="hero-drawing" aria-label="Teknisk tegning af et bukket stålbeslag med udfoldning, mål og tegningshoved">
  <svg viewBox="0 0 640 480" role="img" aria-hidden="true">
    <defs>
      <marker id="arr" viewBox="0 0 10 10" refX="10" refY="5" markerWidth="9" markerHeight="9" orient="auto-start-reverse">
        <path d="M0 1.5L10 5L0 8.5z" fill="#111" />
      </marker>
    </defs>

    <!-- Ramme og koordinater -->
    <g class="d-frame" fill="none" stroke="#111">
      <rect x="8" y="8" width="624" height="464" stroke-width="1" />
      <rect class="draw" pathLength="1" x="24" y="24" width="592" height="432" stroke-width="2" />
      <path d="M172 8v16M320 8v16M468 8v16M172 456v16M320 456v16M468 456v16M8 168h16M8 312h16M616 168h16M616 312h16" stroke-width="1" />
    </g>
    <g class="d-text" font-family="IBM Plex Mono, monospace" font-size="10" fill="#55595d" text-anchor="middle">
      <text x="98" y="19">A</text><text x="246" y="19">B</text><text x="394" y="19">C</text><text x="542" y="19">D</text>
      <text x="16" y="100">1</text><text x="16" y="244">2</text><text x="16" y="388">3</text>
    </g>

    <!-- Sidebillede: L-profil t=3, indvendig radius -->
    <g fill="none" stroke="#000" stroke-width="2.2" stroke-linejoin="round">
      <path class="draw" pathLength="1" style="--d:.2s" d="M80 120V292a8 8 0 0 0 8 8H240V291H96a7 7 0 0 1-7-7V120z" />
    </g>
    <!-- Mål på sidebilledet -->
    <g class="dim" stroke="#111" stroke-width=".9" fill="none">
      <path d="M80 112V86M89 112V96" />
      <path d="M80 318v26M240 318v26" />
      <path class="draw" pathLength="1" style="--d:1.1s" d="M84 334H236" marker-start="url(#arr)" marker-end="url(#arr)" />
      <path d="M72 120H46M72 300H46" />
      <path class="draw" pathLength="1" style="--d:1.2s" d="M56 124V296" marker-start="url(#arr)" marker-end="url(#arr)" />
      <path d="M150 300l40 40h34" />
    </g>
    <g class="d-text" font-family="IBM Plex Mono, monospace" font-size="12" fill="#000">
      <text x="160" y="328" text-anchor="middle">160</text>
      <text x="46" y="210" text-anchor="middle" transform="rotate(-90 46 210)">100</text>
      <text x="228" y="344">R3, t=3</text>
      <text x="80" y="76" font-size="10" fill="#55595d">SIDEBILLEDE</text>
    </g>

    <!-- Udfoldning -->
    <g fill="none" stroke="#000" stroke-width="2.2">
      <rect class="draw" pathLength="1" style="--d:.5s" x="300" y="96" width="254" height="120" />
      <circle class="draw" pathLength="1" style="--d:.9s" cx="340" cy="128" r="9" />
      <circle class="draw" pathLength="1" style="--d:.95s" cx="340" cy="184" r="9" />
      <circle class="draw" pathLength="1" style="--d:1s" cx="490" cy="156" r="13" />
    </g>
    <path class="bend" d="M397 88V224" fill="none" stroke="#FF7621" stroke-width="2.4" stroke-dasharray="10 6" />
    <g stroke="#55595d" stroke-width=".7" stroke-dasharray="6 3 1 3" fill="none">
      <path d="M326 128h28M340 114v28M326 184h28M340 170v28M470 156h40M490 136v40" />
    </g>
    <g class="dim" stroke="#111" stroke-width=".9" fill="none">
      <path d="M300 90V60M554 90V60" />
      <path class="draw" pathLength="1" style="--d:1.3s" d="M304 70H550" marker-start="url(#arr)" marker-end="url(#arr)" />
      <path d="M560 96h34M560 216h34" />
      <path class="draw" pathLength="1" style="--d:1.35s" d="M584 100V212" marker-start="url(#arr)" marker-end="url(#arr)" />
      <path d="M496.5 144.7l40-40h32" />
    </g>
    <g class="d-text" font-family="IBM Plex Mono, monospace" font-size="12" fill="#000">
      <text x="427" y="64" text-anchor="middle">254</text>
      <text x="578" y="156" text-anchor="middle" transform="rotate(-90 578 156)">120</text>
      <text x="572" y="100">Ø26</text>
      <text x="404" y="238" fill="#000">BUK 90° OP  R3</text>
      <text x="300" y="52" font-size="10" fill="#55595d">UDFOLDNING  K=0,33</text>
    </g>

    <!-- Tegningshoved -->
    <g class="d-head">
      <rect x="372" y="328" width="244" height="128" fill="#fff" stroke="#000" stroke-width="2" />
      <path d="M372 360h244M372 392h244M372 424h244M462 360v96M540 392v64" stroke="#000" stroke-width="1" fill="none" />
      <path d="M384 336h14l6 9-6 9h-14l-6-9z" fill="#000" />
      <g font-family="IBM Plex Mono, monospace" font-size="10" fill="#55595d">
        <text x="380" y="378">BENÆVNELSE</text><text x="380" y="410">MATERIALE</text><text x="380" y="442">TEGN.NR.</text>
        <text x="548" y="410">SKALA</text><text x="548" y="442">REV.</text>
      </g>
      <g font-family="IBM Plex Mono, monospace" font-size="12" fill="#000">
        <text x="412" y="350" font-family="Barlow Condensed, sans-serif" font-weight="700" font-size="17">PROCAD</text>
        <text x="470" y="379">Beslag, bukket</text>
        <text x="470" y="411">S235, t=3</text>
        <text x="470" y="443">PC-0001</text>
        <text x="586" y="411">1:2</text>
        <text x="586" y="443">A</text>
        <text x="510" y="350" font-size="10" fill="#55595d">ISO 2768-mK</text>
      </g>
    </g>
  </svg>
</figure>

<style>
  .hero-drawing { margin: 0; background: #fff; border: 2px solid #000; box-shadow: var(--shadow-hard); }
  .hero-drawing svg { width: 100%; height: auto; }
  .draw { stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 1.1s cubic-bezier(.6,.1,.2,1) forwards; animation-delay: var(--d, 0s); }
  .bend { opacity: 0; animation: fade .4s ease forwards .9s; }
  .d-text, .d-head { opacity: 0; animation: fade .6s ease forwards 1.6s; }
  .dim > path:not(.draw) { opacity: 0; animation: fade .4s ease forwards 1s; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes fade { to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .draw, .bend, .d-text, .d-head, .dim > path { animation: none !important; stroke-dashoffset: 0; opacity: 1; }
    .draw { stroke-dasharray: none; }
  }
</style>
