---
import Breadcrumbs from './Breadcrumbs.astro';
import type { Crumb } from '../data/types';
interface Props { crumbs: Crumb[]; title: string; lead?: string; problem?: string }
const { crumbs, title, lead, problem } = Astro.props;
---
<header class="page-header grid-paper">
  <div class="container">
    <Breadcrumbs items={crumbs} />
    {problem && <p class="page-header__problem">{problem}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</header>

<style>
  .page-header { border-bottom: 2px solid #000; padding-block: 2rem clamp(2.5rem, 5vw, 4.5rem); }
  .page-header h1 { margin-top: 1.5rem; max-width: 20ch; }
  .page-header .lead { margin-top: 1.25rem; }
  .page-header__problem { margin-top: 1.5rem; font-family: var(--font-mono); font-size: var(--fs-sm); display: inline-block; background: #000; color: #fff; padding: .3rem .7rem; }
  .page-header__problem + h1 { margin-top: 1rem; }
</style>
