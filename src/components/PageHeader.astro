---
import Breadcrumbs from './Breadcrumbs.astro';
import type { Crumb } from '../data/types';
interface Props { crumbs: Crumb[]; title: string; lead?: string; problem?: string }
const { crumbs, title, lead, problem } = Astro.props;
---
<header class="ph-head grid-paper">
  <div class="container">
    <Breadcrumbs items={crumbs} />
    {problem && <p class="kicker ph-head__kicker">{problem}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</header>

<style>
  .ph-head { padding-block: 1.5rem clamp(2rem, 1.5rem + 3vw, 3.5rem); }
  .ph-head h1 { margin-top: clamp(1.5rem, 1rem + 2.5vw, 3rem); max-width: 20ch; font-size: clamp(2.25rem, 1.4rem + 3vw, 3.5rem); }
  .ph-head__kicker { margin: clamp(1.5rem, 1rem + 2.5vw, 3rem) 0 0; }
  .ph-head__kicker + h1 { margin-top: .75rem; }
  .ph-head .lead { margin-top: 1rem; }
</style>
