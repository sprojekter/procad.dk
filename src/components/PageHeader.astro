---
// Kompakt sidehoved. Brødkrummer kun på sider to niveauer nede (send crumbs med).
import Breadcrumbs from './Breadcrumbs.astro';
import type { Crumb } from '../data/types';
interface Props { crumbs?: Crumb[]; title: string; lead?: string; problem?: string }
const { crumbs, title, lead, problem } = Astro.props;
---
<header class="ph-head">
  <div class="wrap">
    {crumbs && crumbs.length > 1 && <Breadcrumbs items={crumbs} />}
    {problem && <p class="kicker ph-head__kicker">{problem}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</header>

<style>
  .ph-head { padding-block: clamp(1.5rem, 1rem + 2vw, 3rem) clamp(1rem, .75rem + 1.5vw, 2rem); }
  .ph-head h1 { margin-top: .75rem; max-width: 22ch; font-size: clamp(2rem, 1.3rem + 2.6vw, 3.25rem); }
  .ph-head__kicker { margin: .5rem 0 0; }
  .ph-head .lead { margin-top: .75rem; }
</style>
