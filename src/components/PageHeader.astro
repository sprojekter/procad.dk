---
import Breadcrumbs from './Breadcrumbs.astro';
import type { Crumb } from '../data/types';
interface Props { crumbs: Crumb[]; title: string; lead?: string; problem?: string }
const { crumbs, title, lead, problem } = Astro.props;
---
<header class="ph-head grid-paper">
  <div class="container">
    <Breadcrumbs items={crumbs} />
    {problem && <p class="kicker ph-head__kicker">{problem}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</header>

<style>
  .ph-head { padding-block: 2rem clamp(3rem, 2rem + 5vw, 6rem); }
  .ph-head h1 { margin-top: clamp(2.5rem, 2rem + 3vw, 4.5rem); max-width: 18ch; font-size: clamp(2.5rem, 1.5rem + 4vw, 4.25rem); }
  .ph-head__kicker { margin: clamp(2.5rem, 2rem + 3vw, 4.5rem) 0 0; }
  .ph-head__kicker + h1 { margin-top: 1rem; }
  .ph-head .lead { margin-top: 1.5rem; }
</style>
