---
import { site } from '../data/site';
import type { Crumb } from '../data/types';
interface Props { items: Crumb[] }
const { items } = Astro.props;
const all: Crumb[] = [{ label: 'Forside', href: '/' }, ...items];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: all.map((c, i) => ({
    '@type': 'ListItem', position: i + 1, name: c.label, item: new URL(c.href, site.url).href,
  })),
};
---
<nav class="breadcrumbs" aria-label="Brødkrummer">
  <ol>
    {all.map((c, i) => (
      <li>{i === all.length - 1 ? <span aria-current="page">{c.label}</span> : <a href={c.href}>{c.label}</a>}</li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
