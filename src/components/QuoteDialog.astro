---
// Global tilbudsdialog: åbnes fra alle links/knapper med [data-open-quote].
// Mobil: fuldskærms-ark nedefra. Computer: centreret dialog. Tilbage-knappen lukker den.
// Uden JS fører linkene til /kontakt/ (progressiv forbedring).
import QuoteForm from './QuoteForm.astro';
---
<dialog class="qd" id="quote-dialog" aria-labelledby="qd-title">
  <div class="qd__inner">
    <header class="qd__head">
      <span class="qd__grip" aria-hidden="true"></span>
      <h2 id="qd-title" class="qd__title">Få en fast pris</h2>
      <button type="button" class="qd__close" data-close-quote aria-label="Luk">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </header>
    <p class="qd__lead">Send det, du har. Du får svar inden for 24 timer på hverdage.</p>
    <QuoteForm id="tilbud-dialog" inDialog />
  </div>
</dialog>

<style>
  .qd { padding: 0; border: 0; background: transparent; max-width: none; max-height: none; width: 100%; height: 100%; margin: 0; color: var(--c-body); }
  .qd::backdrop { background: rgba(8, 8, 10, .55); backdrop-filter: blur(4px); }
  .qd__inner { position: absolute; inset: auto 0 0 0; max-height: 100dvh; height: 100dvh; overflow-y: auto; overscroll-behavior: contain; background: var(--c-white); padding: 0 1.25rem 0; display: grid; align-content: start; gap: .75rem; }
  .qd[open] .qd__inner { animation: qd-up .32s var(--ease); }
  @keyframes qd-up { from { transform: translateY(24px); opacity: 0; } to { transform: none; opacity: 1; } }
  .qd__head { position: sticky; top: 0; z-index: 2; display: grid; grid-template-columns: 1fr auto; align-items: center; padding: .75rem 0 .5rem; background: var(--c-white); }
  .qd__grip { display: none; }
  .qd__title { font-size: var(--fs-lg); letter-spacing: -0.02em; }
  .qd__close { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 50%; border: 1px solid var(--c-line); background: var(--c-paper); color: var(--c-ink); cursor: pointer; }
  .qd__lead { font-size: var(--fs-sm); color: var(--c-muted); margin-top: -.25rem; }
  @media (min-width: 48rem) {
    .qd__inner { inset: 50% auto auto 50%; transform: translate(-50%, -50%); width: min(40rem, calc(100% - 2rem)); height: auto; max-height: min(52rem, 92dvh); border-radius: var(--r-xl); border: 1px solid var(--c-line); box-shadow: var(--shadow-lg); padding: 0 2rem; }
    .qd[open] .qd__inner { animation: qd-in .25s var(--ease); }
    @keyframes qd-in { from { opacity: 0; transform: translate(-50%, calc(-50% + 12px)); } to { opacity: 1; transform: translate(-50%, -50%); } }
    .qd__head { padding-top: 1.5rem; }
    .qd :global(.qf) { padding-bottom: 1.5rem; }
  }
  @media (max-width: 47.99rem) {
    .qd__grip { display: block; position: absolute; left: 50%; top: .4rem; width: 2.5rem; height: 4px; border-radius: 4px; background: var(--c-line-strong); transform: translateX(-50%); }
    .qd__head { padding-top: 1.1rem; }
  }
  :global(html.qd-open) { overflow: hidden; }
</style>

<script>
  const dlg = document.getElementById('quote-dialog') as HTMLDialogElement | null;
  if (dlg && typeof dlg.showModal === 'function') {
    const form = dlg.querySelector('form')!;
    let opener: HTMLElement | null = null;
    const open = (service?: string, files?: File[]) => {
      if (dlg.open) return;
      opener = document.activeElement as HTMLElement;
      form.dispatchEvent(new CustomEvent('qf:reset-step'));
      if (service) form.dispatchEvent(new CustomEvent('qf:preselect', { detail: service }));
      dlg.showModal();
      document.documentElement.classList.add('qd-open');
      history.pushState({ quoteDialog: true }, '');
      if (files?.length) window.dispatchEvent(new CustomEvent('procad:quote-files', { detail: files }));
      (dlg.querySelector('textarea') as HTMLElement | null)?.focus();
    };
    const close = (fromHistory = false) => {
      if (!dlg.open) return;
      dlg.close();
      document.documentElement.classList.remove('qd-open');
      if (!fromHistory && history.state?.quoteDialog) history.back();
      opener?.focus();
    };
    (window as any).procadOpenQuote = open;

    document.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLElement>('[data-open-quote]');
      if (!a) return;
      const me = e as MouseEvent;
      if (me.metaKey || me.ctrlKey || me.shiftKey) return; // åbn /kontakt/ i ny fane som normalt
      e.preventDefault();
      open(a.dataset.service);
    });
    dlg.querySelector('[data-close-quote]')!.addEventListener('click', () => close());
    dlg.addEventListener('cancel', (e) => { e.preventDefault(); close(); }); // Escape
    dlg.addEventListener('click', (e) => { if (e.target === dlg) close(); }); // klik på baggrunden
    window.addEventListener('popstate', () => close(true));
  }
</script>
