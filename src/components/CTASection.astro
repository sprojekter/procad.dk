---
// Afsluttende CTA – mørkt panel nederst på alle sider (ingen blindgyder).
import QuoteForm from './QuoteForm.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';
interface Props { heading?: string; text?: string; withForm?: boolean; preselect?: string; ctaHref?: string }
const {
  heading = 'Send din tegning, skitse eller fil.',
  text = 'DXF, STEP, PDF eller et foto af en skitse. Du får en fast pris, før jeg går i gang.',
  withForm = false,
  preselect = '',
  ctaHref = '/kontakt/',
} = Astro.props;
---
<section class="cta section" aria-labelledby="cta-heading">
  <div class="container">
    <div class:list={['cta__panel bg-dark', { 'cta__panel--form': withForm }]}>
      <div class="cta__copy">
        <h2 id="cta-heading">{heading}</h2>
        <p class="lead">{text}</p>
        <ul class="cta__points">
          <li><Icon icon="clock" /> Svar inden for {site.responseHours} timer på hverdage</li>
          <li><Icon icon="price" /> Fast pris – ingen overraskelser</li>
          <li><Icon icon="lock" /> Fortroligt. NDA, hvis du har brug for det</li>
        </ul>
        {!withForm && (
          <div class="cta__actions">
            <a href={ctaHref} class="btn btn-primary">Få et tilbud</a>
            <a href={`mailto:${site.email}`} class="btn btn-secondary">Skriv en mail</a>
          </div>
        )}
      </div>
      {withForm && (
        <div class="cta__form">
          <QuoteForm id="tilbud-cta" preselect={preselect} submitLabel="Send og få en fast pris" />
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .cta__panel { position: relative; overflow: hidden; border-radius: var(--r-xl); padding: clamp(1.5rem, 1rem + 4vw, 4rem); display: grid; gap: 2.5rem; }
  .cta__panel::before { content: ""; position: absolute; inset: auto -20% -60% auto; width: 60rem; height: 40rem; background: radial-gradient(closest-side, rgba(255,118,33,.16), transparent); pointer-events: none; }
  .cta__panel > * { position: relative; }
  @media (min-width: 64rem) { .cta__panel--form { grid-template-columns: 4fr 6fr; align-items: start; } }
  .cta__copy h2 { max-width: 16ch; }
  .cta__copy .lead { margin-top: 1.25rem; }
  .cta__points { list-style: none; padding: 0; margin: 2.25rem 0 0; display: grid; gap: .9rem; font-size: var(--fs-sm); color: var(--c-dark-text); }
  .cta__points li { display: flex; align-items: center; gap: .85rem; }
  .cta__actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2.25rem; }
  .cta__form { background: var(--c-white); color: var(--c-body); border: 1px solid var(--c-line); border-radius: var(--r-lg); padding: clamp(1.25rem, 3vw, 2rem); }
  /* Formularen er en lys flade inde i det mørke panel: nulstil de mørke regler */
  .cta__form :global(h2), .cta__form :global(label), .cta__form :global(legend) { color: var(--c-ink); }
  .cta__form :global(.btn-primary) { background: var(--c-ink); color: var(--c-on-ink); }
  .cta__form :global(.field-error) { color: var(--c-danger); }
  .cta__form :global(.hint) { color: var(--c-muted); }
</style>
