---
import '@fontsource-variable/inter';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import MobileDock from '../components/MobileDock.astro';
import QuoteDialog from '../components/QuoteDialog.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, ogImage = '/og.png', schema = [], noindex: noindexProp = false } = Astro.props;
const noindex = noindexProp || import.meta.env.PUBLIC_NOINDEX === 'true'; // forhåndsvisning på GitHub Pages
// Canonical peger altid på procad.dk uden forhåndsvisningens base-sti (/procad.dk/ på GitHub Pages)
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const cleanPath = basePath && Astro.url.pathname.startsWith(basePath) ? Astro.url.pathname.slice(basePath.length) || '/' : Astro.url.pathname;
const canonical = new URL(cleanPath, site.url).href;
const fullTitle = title.includes('ProCAD') ? title : `${title} | ProCAD`;
const ogUrl = new URL(ogImage, site.url).href;
const gtmId = site.gtmId;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${site.url}/#organization`,
  name: site.name,
  slogan: site.tagline,
  description: site.description,
  url: site.url,
  logo: `${site.url}/logo.svg`,
  image: `${site.url}/og.png`,
  email: site.email,
  telephone: site.phoneHref.replace('tel:', ''),
  vatID: `DK${site.cvr}`,
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Region Sjælland' },
    { '@type': 'AdministrativeArea', name: 'Region Hovedstaden' },
    { '@type': 'Country', name: 'Danmark' },
  ],
  address: {
    '@type': 'PostalAddress',
    addressCountry: site.address.country,
  },
  founder: { '@type': 'Person', name: site.owner.name, jobTitle: site.owner.role },
  knowsAbout: ['CAD-tegning', 'Arbejdstegninger', 'DXF-filer til laserskæring', 'Pladeudfoldning', '3D-modellering', 'Teknisk dokumentation'],
  ...(site.linkedin ? { sameAs: [site.linkedin] } : {}),
};
---
<!doctype html>
<html lang="da" class="no-js" data-base={import.meta.env.BASE_URL.replace(/\/$/, '')}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="da_DK" />
    <meta property="og:site_name" content="ProCAD" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f7f7f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0b0d" media="(prefers-color-scheme: dark)" />
    <!-- Tema sættes før første maling, så siden ikke blinker -->
    <script is:inline>
      (function () {
        var d = document.documentElement, mq = window.matchMedia('(prefers-color-scheme: dark)');
        var saved = null; try { saved = localStorage.getItem('procad-theme'); } catch (e) {}
        function apply(t) {
          d.setAttribute('data-theme', t);
          var m = document.querySelectorAll('meta[name="theme-color"]');
          for (var i = 0; i < m.length; i++) { m[i].removeAttribute('media'); m[i].setAttribute('content', t === 'dark' ? '#0b0b0d' : '#f7f7f5'); }
        }
        window.procadApplyTheme = apply;
        apply(saved === 'light' || saved === 'dark' ? saved : (mq.matches ? 'dark' : 'light'));
        mq.addEventListener && mq.addEventListener('change', function (e) {
          var s = null; try { s = localStorage.getItem('procad-theme'); } catch (err) {}
          if (s !== 'light' && s !== 'dark') apply(e.matches ? 'dark' : 'light');
        });
      })();
    </script>

    <!-- Consent Mode v2: alt afvist som standard, indtil brugeren vælger -->
    <script is:inline define:vars={{ gtmId }}>
      document.documentElement.classList.remove('no-js');
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag('consent', 'default', {
        ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied',
        analytics_storage: 'denied', functionality_storage: 'granted', security_storage: 'granted',
        wait_for_update: 500,
      });
      window.procadLoadGtm = function () {
        if (!gtmId || window.__gtmLoaded) return;
        window.__gtmLoaded = true;
        window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var s = document.createElement('script');
        s.async = true; s.src = 'https://www.googletagmanager.com/gtm.js?id=' + gtmId;
        document.head.appendChild(s);
      };
      window.procadApplyConsent = function (c) {
        window.gtag('consent', 'update', {
          analytics_storage: c.analytics ? 'granted' : 'denied',
          ad_storage: c.marketing ? 'granted' : 'denied',
          ad_user_data: c.marketing ? 'granted' : 'denied',
          ad_personalization: c.marketing ? 'granted' : 'denied',
        });
        // "Basic" Consent Mode: GTM indlæses først efter samtykke (mest sikkert i DK)
        if (c.analytics || c.marketing) window.procadLoadGtm();
      };
      try {
        var saved = JSON.parse(localStorage.getItem('procad-consent') || 'null');
        if (saved && saved.v === 1) window.procadApplyConsent(saved);
      } catch (e) {}
    </script>

    {[orgSchema, ...schema].map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </head>
  <body>
    <a href="#indhold" class="skip-link">Spring til indhold</a>
    <Header />
    <main id="indhold">
      <slot />
    </main>
    <Footer />
    <MobileDock />
    <QuoteDialog />
    <CookieBanner />

  </body>
</html>
