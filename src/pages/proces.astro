---
// Proces som lodret stepper – ét trin åbent ad gangen (sekvens = tidslinje, ikke grid).
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CTASection from '../components/CTASection.astro';
import { processSteps } from '../data/process';
const send = ['Skitse, foto, PDF, DXF, DWG eller STEP', 'Materiale og tykkelse', 'Antal emner', 'Maskine eller proces', 'Kritiske mål og tolerancer', 'Jeres tegningsramme', 'Ønsket leveringsdato'];
const modes = [
  { t: 'Hele opgaven', d: 'Fra skitse til færdige tegninger og filer.' },
  { t: 'I modellerer, jeg tegner', d: 'Jeres konstruktør laver 3D-modellen, jeg laver produktionstegningerne.' },
  { t: 'Ekstra kapacitet', d: 'En ekstra tegner i travle perioder – timepris eller timebank.' },
];
---
<BaseLayout
  title="Sådan arbejder jeg – fra fil eller skitse til færdig tegning | ProCAD"
  description="Upload, svar inden 24 timer, kort afklaring, fast pris og levering inkl. mindre rettelser. Se hvordan et samarbejde med ProCAD foregår."
>
  <PageHeader title="Fra fil til færdig tegning." lead="Fem trin. Du kender prisen, før jeg går i gang." />

  <section class="section section--tight">
    <div class="wrap pr">
      <ol class="stepper">
        {processSteps.map((s, i) => (
          <li>
            <details name="trin" open={i === 0}>
              <summary>
                <span class="stepper__num">{String(i + 1).padStart(2, '0')}</span>
                <span class="stepper__t"><strong>{s.title}</strong><small>{s.promise}</small></span>
              </summary>
              <p>{s.details}</p>
            </details>
          </li>
        ))}
      </ol>

      <aside class="pr__aside">
        <details class="box" open>
          <summary>Det er godt at sende med</summary>
          <ul class="dots">{send.map((x) => <li>{x}</li>)}</ul>
          <p class="muted">Mangler du noget? Send det, du har.</p>
        </details>
        <div class="box">
          <h2 class="box__h">Tre måder at samarbejde på</h2>
          <ul class="modes">{modes.map((m) => <li><strong>{m.t}</strong><span>{m.d}</span></li>)}</ul>
          <a href="/priser/" class="link">Sådan prissætter jeg</a>
        </div>
      </aside>
    </div>
  </section>

  <CTASection />
</BaseLayout>

<style>
  .pr { display: grid; gap: 1.5rem; }
  @media (min-width: 64rem) { .pr { grid-template-columns: 1.4fr 1fr; gap: 4rem; align-items: start; } .pr__aside { position: sticky; top: calc(var(--header-h) + 1.5rem); } }
  .stepper { list-style: none; padding: 0; margin: 0; position: relative; }
  .stepper::before { content: ""; position: absolute; left: 1.375rem; top: 1.5rem; bottom: 1.5rem; width: 1px; background: var(--c-line-strong); }
  .stepper li { position: relative; }
  .stepper summary { list-style: none; cursor: pointer; display: grid; grid-template-columns: 2.75rem 1fr; gap: 1rem; align-items: center; min-height: 4rem; }
  .stepper summary::-webkit-details-marker { display: none; }
  .stepper__num { position: relative; z-index: 1; display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 50%; background: var(--c-white); border: 1px solid var(--c-line-strong); font: 500 var(--fs-xs) var(--font-mono); color: var(--c-ink); }
  .stepper details[open] .stepper__num { background: var(--c-ink); color: var(--c-on-ink); border-color: var(--c-ink); }
  .stepper__t { display: grid; }
  .stepper__t strong { color: var(--c-ink); font-weight: 600; font-size: var(--fs-lg); letter-spacing: -0.015em; }
  .stepper__t small { color: var(--c-muted); font-size: var(--fs-sm); }
  .stepper details p { margin: 0 0 1rem 3.75rem; color: var(--c-muted); font-size: var(--fs-sm); max-width: 56ch; }
  .pr__aside { display: grid; gap: 1rem; }
  .box { background: var(--c-white); border: 1px solid var(--c-line); border-radius: var(--r-lg); padding: 1.25rem 1.5rem; display: grid; gap: .9rem; font-size: var(--fs-sm); }
  .box summary, .box__h { font-size: var(--fs-base); font-weight: 600; color: var(--c-ink); letter-spacing: -0.01em; }
  .box summary { list-style: none; cursor: pointer; min-height: 2.75rem; display: flex; align-items: center; }
  .box summary::-webkit-details-marker { display: none; }
  .box details[open] summary, details.box[open] > summary { margin-bottom: .5rem; }
  .dots { list-style: none; padding: 0; margin: 0; display: grid; gap: .4rem; }
  @media (min-width: 30rem) { .dots { grid-template-columns: 1fr 1fr; column-gap: 1rem; } }
  .dots li { position: relative; padding-left: 1.1rem; }
  .dots li::before { content: ""; position: absolute; left: .1rem; top: .62em; width: 5px; height: 5px; border-radius: 50%; background: var(--c-orange); }
  .modes { list-style: none; padding: 0; margin: 0; display: grid; gap: .75rem; }
  .modes li { display: grid; }
  .modes strong { color: var(--c-ink); font-weight: 500; }
  .modes span { color: var(--c-muted); }
</style>
