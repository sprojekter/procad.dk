---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---
<BaseLayout title="Tak – din forespørgsel er sendt | ProCAD" description="Tak for din forespørgsel til ProCAD." noindex>
  <section class="section grid-paper thanks">
    <div class="container">
      <div class="card thanks__box">
        <span class="thanks__icon" aria-hidden="true"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span>
        <h1>Tak – din forespørgsel er sendt</h1>
        <p class="lead">Jeg kigger på dit materiale og vender tilbage inden for {site.responseHours} timer på hverdage, enten med spørgsmål eller en fast pris.</p>
        <p>Haster det? Ring på <a href={site.phoneHref} class="link">{site.phone}</a>.</p>
        <div class="thanks__actions">
          <a href="/cases/" class="btn btn-primary">Se cases imens</a>
          <a href="/" class="btn btn-secondary">Til forsiden</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Konvertering sendes allerede fra formularen ("generate_lead").
  // Her sendes en ekstra sidevisnings-hændelse, kun hvis brugeren kom fra formularen.
  try {
    if (sessionStorage.getItem('procad-lead') === '1') {
      (window as any).dataLayer?.push({ event: 'lead_thankyou_view' });
      sessionStorage.removeItem('procad-lead');
    }
  } catch {}
</script>

<style>
  .thanks { min-height: 60vh; display: grid; align-items: center; }
  .thanks__icon { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; background: var(--c-orange-soft); color: var(--c-ink); }
  .thanks__box { max-width: 44rem; margin-inline: auto; padding: clamp(1.5rem, 5vw, 3.5rem); display: grid; gap: 1.25rem; justify-items: start; }
  .thanks__actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: .75rem; }
</style>
