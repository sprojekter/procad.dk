---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CTASection from '../components/CTASection.astro';
import { faq, faqCategories, type FaqItem } from '../data/faq';

const cats = Object.entries(faqCategories) as [FaqItem['cat'], string][];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })),
};
---
<BaseLayout
  title="Spørgsmål og svar – pris, leveringstid, filformater og NDA | ProCAD"
  description="Hvad koster en arbejdstegning? Hvilke filformater leverer I? Skriver I under på NDA? Svar på de spørgsmål, kunderne oftest stiller."
  schema={[schema]}
>
  <PageHeader
    crumbs={[{ label: 'FAQ', href: '/faq/' }]}
    title="Spørgsmål og svar"
    lead="Vælg et emne – eller send dit spørgsmål med din fil."
  />

  <section class="section section--tight faqs">
    <div class="wrap faqp" data-faq>
      <div class="faqp__tools">
        <div class="faqp__cats" role="group" aria-label="Emner">
          <button type="button" class="faqp__cat" aria-pressed="true" data-cat="alle">Alle</button>
          {cats.map(([k, v]) => <button type="button" class="faqp__cat" aria-pressed="false" data-cat={k}>{v}</button>)}
        </div>
      </div>

      <div class="faqp__list">
        {faq.map((i) => (
          <details class="faq-item" data-cat={i.cat}>
            <summary>{i.q}</summary>
            <div class="faq-answer"><p>{i.a}</p></div>
          </details>
        ))}
        <p class="faqp__empty" hidden data-faq-empty>Ingen spørgsmål her. <a href="/kontakt/" class="link" data-open-quote>Spørg mig direkte</a></p>
      </div>
    </div>
  </section>

  <CTASection heading="Fandt du ikke svaret?" text="Send dit spørgsmål sammen med din fil – så får du både svar og en pris." />
</BaseLayout>

<style>
  .faqp { display: grid; gap: 2rem; }
  @media (min-width: 64rem) { .faqp { grid-template-columns: 18rem 1fr; gap: 4rem; align-items: start; } .faqp__tools { position: sticky; top: calc(var(--header-h) + 1.5rem); } }
  .faqp__tools { display: grid; gap: 1rem; }
  .faqp__cats { display: flex; gap: .4rem; overflow-x: auto; scrollbar-width: none; margin-inline: calc(-1 * clamp(1.25rem, .5rem + 3vw, 2.5rem)); padding: .5rem clamp(1.25rem, .5rem + 3vw, 2.5rem); position: sticky; top: 0; z-index: 5; background: var(--c-paper); }
  .faqp__cats::-webkit-scrollbar { display: none; }
  @media (min-width: 64rem) { .faqp__cats { margin: 0; padding: 0; position: static; background: none; } }
  @media (min-width: 64rem) { .faqp__cats { flex-direction: column; align-items: stretch; } }
  .faqp__cat { flex: 0 0 auto; min-height: 2.75rem; text-align: left; font: 500 .9375rem var(--font-sans); color: var(--c-muted); background: var(--c-white); border: 1px solid var(--c-line); border-radius: 999px; padding: 0 1rem; cursor: pointer; white-space: nowrap; }
  @media (min-width: 64rem) { .faqp__cat { border-radius: 10px; border-color: transparent; } }
  .faqp__cat:hover { color: var(--c-ink); }
  .faqp__cat[aria-pressed="true"] { color: var(--c-ink); background: var(--c-white); border-color: var(--c-line); box-shadow: var(--shadow-sm); }
  .faqp__list { min-width: 0; }
  .faqp__empty { padding: 1.5rem 0; color: var(--c-muted); }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-faq]');
  if (root) {
    const items = Array.from(root.querySelectorAll<HTMLDetailsElement>('.faq-item'));
    const empty = root.querySelector<HTMLElement>('[data-faq-empty]')!;
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-cat]')).filter((b) => b.tagName === 'BUTTON');
    let cat = 'alle';
    const norm = (s: string) => s.toLowerCase().normalize('NFKD');
    const apply = () => {
      const q = '';
      let shown = 0;
      items.forEach((it) => {
        const okCat = cat === 'alle' || it.dataset.cat === cat;
        const okQ = !q || norm(it.textContent || '').includes(q);
        it.hidden = !(okCat && okQ);
        if (!it.hidden) shown++;
        if (q && !it.hidden) it.open = true;
      });
      empty.hidden = shown > 0;
    };
    buttons.forEach((b) => b.addEventListener('click', () => {
      cat = b.dataset.cat || 'alle';
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      apply();
    }));
  }
</script>
