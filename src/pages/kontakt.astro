---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import QuoteForm from '../components/QuoteForm.astro';
import HexIcon from '../components/HexIcon.astro';
import { site } from '../data/site';
const pre = '';
---
<BaseLayout
  title="Få et tilbud – send din tegning, skitse eller fil | ProCAD"
  description="Upload DXF, STEP, PDF eller et foto af din skitse og få en fast pris på CAD-tegninger og filer. Svar inden for 24 timer på hverdage."
>
  <PageHeader
    crumbs={[{ label: 'Kontakt', href: '/kontakt/' }]}
    title="Send din fil og få en fast pris"
    lead="DXF, STEP, PDF eller et foto af en skitse – send det, du har. Du får svar inden for 24 timer på hverdage."
  />

  <section class="section">
    <div class="container contact">
      <div class="contact__form">
        <QuoteForm id="tilbud" preselect={pre} />
      </div>
      <aside class="contact__aside">
        <div class="sheet contact__box">
          <h2 class="contact__h">Direkte kontakt</h2>
          <p><span class="muted">Telefon</span><br /><a href={site.phoneHref} class="contact__big">{site.phone}</a></p>
          <p><span class="muted">E-mail</span><br /><a href={`mailto:${site.email}`} class="contact__big">{site.email}</a></p>
          <dl class="titleblock">
            <dt>Firma</dt><dd>ProCAD</dd>
            <dt>CVR</dt><dd>{site.cvr}</dd>
            <dt>Adresse</dt><dd>{site.address.street}, {site.address.postalCode} {site.address.city}</dd>
            <dt>Åbent</dt><dd>[UDFYLD: Hverdage 7–16]</dd>
          </dl>
        </div>
        <ul class="contact__points">
          <li><HexIcon icon="clock" size={40} /> Svar inden for {site.responseHours} timer på hverdage</li>
          <li><HexIcon icon="price" size={40} /> Fast pris, før jeg går i gang</li>
          <li><HexIcon icon="lock" size={40} /> Filer behandles fortroligt – NDA ved behov</li>
          <li><HexIcon icon="file" size={40} /> Store filer? Indsæt et WeTransfer-link i beskrivelsen</li>
        </ul>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact { display: grid; gap: 3rem; }
  @media (min-width: 64rem) { .contact { grid-template-columns: 1.6fr 1fr; gap: 4rem; align-items: start; } }
  .contact__form { border: 2px solid #000; padding: clamp(1.25rem, 3vw, 2.5rem); box-shadow: var(--shadow-hard); }
  .contact__aside { display: grid; gap: 2rem; }
  .contact__box { padding: 1.5rem; display: grid; gap: 1rem; }
  .contact__h { font-size: var(--fs-2xl); }
  .contact__big { font-family: var(--font-display); font-size: var(--fs-xl); font-weight: 700; text-decoration: none; }
  .contact__big:hover { text-decoration: underline; text-decoration-color: var(--c-orange); }
  .contact__points { list-style: none; padding: 0; margin: 0; display: grid; gap: .9rem; font-size: var(--fs-sm); }
  .contact__points li { display: flex; align-items: center; gap: .9rem; }
</style>
