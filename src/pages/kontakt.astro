---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
---
<BaseLayout
  title="Få et tilbud – send din tegning, skitse eller fil | ProCAD"
  description="Upload DXF, STEP, PDF eller et foto af din skitse og få en fast pris på CAD-tegninger og filer. Svar inden for 24 timer på hverdage."
>
  <section class="ct">
    <div class="wrap ct__grid">
      <div class="ct__intro">
        <h1>Send din fil – få en fast pris.</h1>
        <ul class="ct__chips">
          <li><Icon icon="clock" tile={false} size={16} /> Svar inden 24 timer på hverdage</li>
          <li><Icon icon="price" tile={false} size={16} /> Fast pris</li>
          <li><Icon icon="lock" tile={false} size={16} /> Fortroligt</li>
        </ul>
        <div class="ct__direct">
          <p class="muted">Hellere tale sammen?</p>
          <div class="ct__btns">
            <a href={site.phoneHref} class="btn btn-secondary"><Icon icon="phone" tile={false} size={16} /> Ring</a>
            <a href={`mailto:${site.email}`} class="btn btn-secondary"><Icon icon="mail" tile={false} size={16} /> Skriv en mail</a>
          </div>
          <dl class="titleblock ct__info">
            <dt>Telefon</dt><dd>{site.phone}</dd>
            <dt>E-mail</dt><dd>{site.email}</dd>
            <dt>CVR</dt><dd>{site.cvr}</dd>
            <dt>Åbent</dt><dd>[UDFYLD: Hverdage 7–16]</dd>
          </dl>
        </div>
      </div>
      <div class="ct__form">
        <QuoteForm id="tilbud" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .ct { padding-block: clamp(1.25rem, 1rem + 2vw, 3.5rem) clamp(2rem, 1.5rem + 3vw, 4rem); }
  .ct__grid { display: grid; gap: 1.5rem; }
  @media (min-width: 64rem) { .ct__grid { grid-template-columns: 1fr 1.3fr; gap: 4rem; align-items: start; } .ct__intro { position: sticky; top: calc(var(--header-h) + 1.5rem); } }
  .ct h1 { font-size: var(--fs-h1); }
  .ct__chips { list-style: none; padding: 0; margin: 1rem 0 0; display: flex; flex-wrap: wrap; gap: .4rem 1rem; font-size: var(--fs-sm); color: var(--c-ink); }
  .ct__chips li { display: inline-flex; align-items: center; gap: .35rem; }
  .ct__chips :global(svg) { color: var(--c-muted); }
  .ct__direct { margin-top: 1.25rem; display: grid; gap: .6rem; }
  .ct__direct .muted { font-size: var(--fs-sm); }
  .ct__btns { display: grid; grid-template-columns: 1fr 1fr; gap: .5rem; }
  .ct__btns .btn { min-height: 3rem; }
  .ct__info { display: none; margin-top: 1rem; }
  @media (min-width: 64rem) { .ct__info { display: grid; } .ct__btns { grid-template-columns: auto auto; justify-content: start; } }
  .ct__form { background: var(--c-white); border: 1px solid var(--c-line); border-radius: var(--r-xl); padding: clamp(1.25rem, 3vw, 2.25rem); box-shadow: var(--shadow-md); }
</style>
