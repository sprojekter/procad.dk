---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CTASection from '../components/CTASection.astro';
---
<BaseLayout
  title="Priser – sådan prissætter ProCAD CAD-tegninger og filer"
  description="Fast pris pr. opgave, timepris eller timebank. Se hvad der påvirker prisen på arbejdstegninger, DXF-filer og 3D-modeller – og hvad der er med."
>
  <PageHeader
    title="Sådan prissætter jeg."
    lead="Du får altid prisen, før jeg går i gang. Alle priser er ekskl. moms."
  />

  <section class="section section--tight">
    <div class="wrap">
      <ul class="models">
        <li class="model model--main">
          <h2>Fast pris pr. opgave</h2>
          <p class="model__fit mono">Til de fleste opgaver</p>
          <p>Du sender materialet, jeg giver en fast pris og en leveringsdato. Mindre rettelser inden for opgaven er med.</p>
        </li>
        <li class="model">
          <h2>Timepris</h2>
          <p class="model__fit mono">Til løbende og uafklarede opgaver</p>
          <p class="model__price">[UDFYLD] kr./time</p>
          <p>Når omfanget ikke kan fastlægges på forhånd. Du får et estimat og besked, før det overskrides.</p>
        </li>
        <li class="model">
          <h2>Timebank</h2>
          <p class="model__fit mono">Til ekstra kapacitet</p>
          <p class="model__price">[UDFYLD] timer til [UDFYLD] kr.</p>
          <p>Køb et antal timer til en lavere timepris og brug dem, når tegnestuen har travlt.</p>
        </li>
      </ul>

      <div class="price-grid">
        <div class="acc">
          <details data-open-desktop>
          <summary>Prisen afhænger af</summary>
          <ul class="dots">
            <li><strong>Udgangspunktet.</strong> En 3D-model er hurtigere at tegne efter end en håndskitse.</li>
            <li><strong>Kompleksiteten.</strong> Antal dele, bukninger, svejsninger og kritiske tolerancer.</li>
            <li><strong>Leverancen.</strong> Kun DXF, eller også arbejdstegning, 3D-model og stykliste.</li>
            <li><strong>Tidsfristen.</strong> Hasteopgaver kan lade sig gøre, men kan koste et tillæg.</li>
          </ul>
          </details>
          <details data-open-desktop>
          <summary>Altid med i prisen</summary>
          <ul class="dots">
            <li>Kort afklaring før start</li>
            <li>Kontrol af mål og filer før levering</li>
            <li>Mindre rettelser inden for opgaven [UDFYLD: antal runder]</li>
            <li>Filer i de aftalte formater</li>
          </ul>
          </details>
        </div>
        <div>
          <h2 class="ex-h">Eksempler på priser</h2>
          <table class="ex">
            <thead><tr><th>Opgave</th><th>Typisk pris</th></tr></thead>
            <tbody>
              <tr><td>DXF-oprydning af én pladedel</td><td>[UDFYLD]</td></tr>
              <tr><td>Arbejdstegning + DXF, enkel bukket del</td><td>[UDFYLD]</td></tr>
              <tr><td>Samlingstegning med stykliste (5–10 dele)</td><td>[UDFYLD]</td></tr>
              <tr><td>3D-model ud fra gammel papirtegning</td><td>[UDFYLD]</td></tr>
            </tbody>
          </table>
          <p class="muted ex-note">Vejledende priser ekskl. moms. Din pris afhænger af opgaven.</p>
        </div>
      </div>
    </div>
  </section>

  <CTASection heading="Få en fast pris på din opgave" />
</BaseLayout>

<script>
  // Akkordeoner er åbne på computer, lukkede på mobil (mindre scroll)
  if (window.matchMedia('(min-width: 64rem)').matches) document.querySelectorAll<HTMLDetailsElement>('[data-open-desktop]').forEach((d) => (d.open = true));
</script>

<style>
  .models { list-style: none; padding: 0; margin: 0; display: flex; gap: .75rem; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; margin-inline: calc(-1 * clamp(1.25rem, .5rem + 3vw, 2.5rem)); padding-inline: clamp(1.25rem, .5rem + 3vw, 2.5rem); }
  .models::-webkit-scrollbar { display: none; }
  .model { flex: 0 0 min(82%, 20rem); scroll-snap-align: start; padding: 1.5rem; display: grid; gap: .6rem; align-content: start; background: var(--c-white); border: 1px solid var(--c-line); border-radius: var(--r-xl); box-shadow: var(--shadow-sm); }
  @media (min-width: 56rem) { .models { display: grid; grid-template-columns: 1.15fr 1fr 1fr; overflow: visible; margin: 0; padding: 0; } .model { padding: 2rem; } }
  .model--main { background: var(--c-ink); border-color: var(--c-ink); color: var(--c-on-ink); }
  .model--main h2 { color: var(--c-on-ink); }
  .model--main .model__fit { color: var(--c-orange); }
  .model h2 { font-size: var(--fs-xl); letter-spacing: -0.025em; }
  .model__fit { font-size: var(--fs-sm); color: var(--c-muted); font-family: var(--font-sans); }
  .model__price { font-size: var(--fs-xl); font-weight: 600; letter-spacing: -0.02em; color: var(--c-ink); }
  .model p:last-child { font-size: var(--fs-sm); }
  .price-grid { display: grid; gap: 1.5rem; margin-top: 2rem; }
  @media (min-width: 64rem) { .price-grid { grid-template-columns: 1fr 1fr; gap: 4rem; margin-top: 3rem; } }
  .acc details { border-bottom: 1px solid var(--c-line); }
  .acc details:first-child { border-top: 1px solid var(--c-line); }
  .acc summary { list-style: none; cursor: pointer; min-height: 3.25rem; display: flex; align-items: center; font-weight: 600; color: var(--c-ink); }
  .acc summary::-webkit-details-marker { display: none; }
  .acc summary::after { content: "+"; margin-left: auto; color: var(--c-muted); font-size: 1.25rem; }
  .acc details[open] summary::after { content: "–"; }
  .dots { list-style: none; padding: 0 0 1rem; margin: 0; display: grid; gap: .45rem; font-size: var(--fs-sm); color: var(--c-body); }
  .dots li { position: relative; padding-left: 1.1rem; }
  .dots li::before { content: ""; position: absolute; left: .1rem; top: .62em; width: 5px; height: 5px; border-radius: 50%; background: var(--c-orange); }
  .ex-h { font-size: var(--fs-lg); letter-spacing: -0.02em; margin-bottom: .75rem; }
  .ex { width: 100%; border-collapse: separate; border-spacing: 0; font-size: var(--fs-sm); background: var(--c-white); border: 1px solid var(--c-line); border-radius: var(--r-lg); overflow: hidden; }
  .ex th, .ex td { padding: .8rem 1rem; text-align: left; border-bottom: 1px solid var(--c-line); }
  .ex tr:last-child td { border-bottom: 0; }
  .ex th { color: var(--c-muted); font-weight: 500; background: var(--c-paper); }
  .ex td:last-child { font-variant-numeric: tabular-nums; white-space: nowrap; color: var(--c-ink); font-weight: 500; }
  .ex-note { margin-top: .6rem; font-size: var(--fs-xs); }
</style>
