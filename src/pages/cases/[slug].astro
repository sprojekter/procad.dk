---
import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Media from '../../components/Media.astro';
import CTASection from '../../components/CTASection.astro';

export async function getStaticPaths() {
  const cases = await getCollection('cases');
  return cases.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
interface Props { entry: CollectionEntry<'cases'> }
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const service = await getEntry('ydelser', d.service);
---
<BaseLayout title={`${d.title} | Case | ProCAD`} description={d.metaDescription}>
  <PageHeader
    crumbs={[{ label: 'Cases', href: '/cases/' }, { label: d.title, href: `/cases/${entry.id}/` }]}
    title={d.title}
    lead={d.summary}
  >
    <dl class="titleblock case-meta">
      <dt>Kunde</dt><dd>{d.customer}</dd>
      <dt>Branche</dt><dd>{d.industry}</dd>
      {d.facts.map((f) => <><dt>{f.label}</dt><dd>{f.value}</dd></>)}
      <dt>År</dt><dd>{d.year}</dd>
    </dl>
  </PageHeader>

  {d.example && (
    <div class="container"><p class="example-note">Eksempel-case: teksten og billederne viser skabelonen og skal erstattes med en rigtig opgave.</p></div>
  )}

  <section class="section">
    <div class="container">
      <div class="ba">
        <figure class="ba__item reveal">
          <Media src={d.before.src} alt={d.before.alt} spec={d.before.spec} motif={d.before.motif} ratio="4 / 3" eager />
          <figcaption><span class="ba__tag">Før</span> {d.before.alt}</figcaption>
        </figure>
        <figure class="ba__item reveal">
          <Media src={d.after.src} alt={d.after.alt} spec={d.after.spec} motif={d.after.motif} ratio="4 / 3" />
          <figcaption><span class="ba__tag ba__tag--after">Efter</span> {d.after.alt}</figcaption>
        </figure>
      </div>

      <ol class="story">
        <li><h2>Udfordringen</h2><p>{d.challenge}</p></li>
        <li><h2>Løsningen</h2><p>{d.solution}</p></li>
        <li><h2>Resultatet</h2><p>{d.result}</p></li>
      </ol>

      {d.quote && (
        <blockquote class="quote-block">
          <p>“{d.quote.text}”</p>
          <footer class="mono">{d.quote.name}, {d.quote.role}</footer>
        </blockquote>
      )}

      <div class="prose case-prose"><Content /></div>

      {d.gallery.length > 0 && (
        <div class="gallery">{d.gallery.map((g) => <Media src={g.src} alt={g.alt} spec={g.spec} ratio="4 / 3" />)}</div>
      )}

      {service && (
        <p class="case-service">Ydelse: <a href={`/ydelser/${service.id}/`} class="link">{service.data.title}</a></p>
      )}
    </div>
  </section>

  <CTASection heading="Skal din opgave være den næste case?" />
</BaseLayout>

<style>
  .case-meta { margin-top: 2.5rem; max-width: 40rem; }
  .example-note { margin-top: 1.5rem; padding: .85rem 1.1rem; border: 1px solid #ffd2b3; border-radius: var(--r-md); background: #fff4ec; font-size: var(--fs-sm); color: var(--c-ink); }
  .ba { display: grid; gap: 1rem; }
  @media (min-width: 48rem) { .ba { grid-template-columns: 1fr 1fr; } }
  .ba__item { margin: 0; background: var(--c-white); border: 1px solid var(--c-line); border-radius: var(--r-xl); padding: 8px; box-shadow: var(--shadow-sm); }
  .ba__item figcaption { padding: .9rem .6rem .5rem; font-size: var(--fs-sm); color: var(--c-muted); display: flex; gap: .7rem; align-items: baseline; }
  .ba__tag { border-radius: 999px; padding: .1rem .6rem; font-size: var(--fs-xs); font-weight: 500; background: var(--c-paper); color: var(--c-ink); border: 1px solid var(--c-line); }
  .ba__tag--after { background: var(--c-ink); color: #fff; border-color: var(--c-ink); }
  .story { list-style: none; padding: 0; margin: 5rem 0 0; display: grid; gap: 2.5rem; counter-reset: s; }
  @media (min-width: 56rem) { .story { grid-template-columns: repeat(3, 1fr); gap: 2.5rem; } }
  .story li { border-top: 1px solid var(--c-line-strong); padding-top: 1.5rem; counter-increment: s; }
  .story li:last-child { border-top-color: var(--c-orange); }
  .story h2 { font-size: var(--fs-xl); letter-spacing: -0.025em; margin-bottom: .75rem; }
  .story h2::before { content: "0" counter(s); display: block; font: 500 var(--fs-xs) var(--font-mono); color: var(--c-muted); margin-bottom: .75rem; }
  .story p { color: var(--c-muted); }
  .quote-block { margin: 5rem 0 0; max-width: 50rem; }
  .quote-block p { font-size: var(--fs-2xl); font-weight: 500; letter-spacing: -0.03em; line-height: 1.25; color: var(--c-ink); }
  .quote-block footer { margin-top: 1rem; color: var(--c-muted); }
  .case-prose { margin-top: 3.5rem; }
  .gallery { display: grid; gap: 1rem; margin-top: 3rem; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); }
  .case-service { margin-top: 3rem; }
</style>
