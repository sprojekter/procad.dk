---
// Forside. Mål: ≤ 3,5 skærme på computer, ≤ 4 på mobil.
// Computer: hero m. 3D · ydelser som faner · cases · proces + hvorfor · FAQ + dropfelt.
// Mobil (eget format): kort hero uden 3D · ydelser 2×2 · cases-karrusel · proces-liste · FAQ · CTA.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Model3D from '../components/Model3D.astro';
import Icon from '../components/Icon.astro';
import Media from '../components/Media.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import CaseCard from '../components/CaseCard.astro';
import FaqList from '../components/FaqList.astro';
import CTASection from '../components/CTASection.astro';
import { site } from '../data/site';
import { faq } from '../data/faq';

const services = (await getCollection('ydelser')).sort((a, b) => a.data.order - b.data.order);
const icons = ['ruler', 'file', 'cube', 'doc'] as const;
const featured = (await getCollection('cases')).filter((c) => c.data.featured).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
const homeFaq = faq.filter((f) => f.home).slice(0, 3);
---
<BaseLayout
  title="Produktionsklare CAD-tegninger til metalbearbejdning | ProCAD"
  description="CAD-tegner med baggrund fra værkstedet. Arbejdstegninger, DXF/STEP til laser, kantbuk og CNC, 3D-modellering og styklister. Fast pris og svar inden 24 timer."
>
  <!-- Hero -->
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="pill"><span class="pill__tag">Fast pris</span> Svar inden 24 timer</p>
        <h1>Produktionsklare CAD-tegninger til metal&shy;bearbejdning.</h1>
        <p class="lead">Arbejdstegninger, DXF/STEP, 3D og styklister – fra en tegner, der kommer fra værkstedet.</p>
        <div class="hero__actions">
          <a href="/kontakt/" class="btn btn-primary hero__cta" data-open-quote>Send fil – få fast pris</a>
          <a href="#cases" class="btn btn-secondary hero__alt">Se før og efter</a>
        </div>
        <ul class="hero__trust" aria-label="Det kan du regne med">
          <li><Icon icon="clock" tile={false} size={16} /> 24 timer</li>
          <li><Icon icon="price" tile={false} size={16} /> Fast pris</li>
          <li><Icon icon="lock" tile={false} size={16} /> NDA</li>
          <li class="hero__trust-wide"><Icon icon="file" tile={false} size={16} /> DXF, DWG, STEP, PDF</li>
        </ul>
      </div>
      <div class="hero__visual"><Model3D /></div>
    </div>
  </section>

  <!-- Ydelser: faner på computer, fliser på mobil -->
  <section class="section section--first" aria-labelledby="ydelser-h">
    <div class="wrap">
      <h2 id="ydelser-h" class="h2">Fra skitse til fil, maskinen kan læse.</h2>

      <ul class="tiles">
        {services.map((s, i) => (
          <li><a href={`/ydelser/${s.id}/`} class="tile card"><Icon icon={icons[i]} /><strong>{s.data.navTitle.replace(' (DXF/STEP)', '')}</strong><span>{s.data.navDescription}</span></a></li>
        ))}
      </ul>

      <div class="tabs" data-tabs>
        <div class="tabs__list" role="tablist" aria-label="Ydelser">
          {services.map((s, i) => (
            <button type="button" role="tab" id={`tab-${s.id}`} aria-controls={`panel-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
              <Icon icon={icons[i]} tile={false} size={18} /> {s.data.navTitle}
            </button>
          ))}
        </div>
        {services.map((s, i) => (
          <div class="tabs__panel card" role="tabpanel" id={`panel-${s.id}`} aria-labelledby={`tab-${s.id}`} hidden={i !== 0}>
            <div class="tabs__text">
              <p class="kicker">{s.data.problem}</p>
              <h3>{s.data.h1}</h3>
              <p class="muted">{s.data.intro}</p>
              <ul class="ticks">{s.data.deliverables.slice(0, 3).map((d) => <li>{d}</li>)}</ul>
              <div class="tabs__actions">
                <a href="/kontakt/" class="btn btn-primary" data-open-quote data-service={s.id}>Få pris på {s.data.navTitle.replace(' (DXF/STEP)', '').toLowerCase()}</a>
                <a href={`/ydelser/${s.id}/`} class="link">Læs mere</a>
              </div>
            </div>
            <Media src={s.data.image.src} alt={s.data.image.alt} ratio="4 / 3" sizes="40vw" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Cases -->
  <section class="section section--tight" id="cases" aria-labelledby="cases-h">
    <div class="wrap">
      <div class="row-head">
        <h2 id="cases-h" class="h2">Før og efter.</h2>
        <a href="/cases/" class="link">Alle cases</a>
      </div>
      <div class="cases">{featured.map((c) => <CaseCard entry={c} />)}</div>
    </div>
  </section>

  <!-- Proces + hvorfor -->
  <section class="section section--tight bg-surface rule-y" aria-labelledby="proces-h">
    <div class="wrap">
      <div class="row-head">
        <h2 id="proces-h" class="h2">Sådan foregår det.</h2>
        <a href="/proces/" class="link">Detaljer</a>
      </div>
      <ProcessSteps />
      <div class="why">
        <p class="why__lead"><strong>Tegnet af en, der har stået ved maskinen.</strong> [UDFYLD: fx uddannet smed, 12 år på værksted.] <a href="/om/" class="link">Om ProCAD</a></p>
        <ul class="why__list">
          <li><Icon icon="chat" tile={false} size={18} /> Dansk og personligt</li>
          <li><Icon icon="ruler" tile={false} size={18} /> DS/EN ISO</li>
          <li><Icon icon="layers" tile={false} size={18} /> Jeres tegningsramme</li>
          <li><Icon icon="cube" tile={false} size={18} /> Hele opgaven eller kapacitet</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- FAQ + dropfelt -->
  <section class="section section--tight" aria-labelledby="faq-h">
    <div class="wrap faq-cta">
      <div>
        <div class="row-head">
          <h2 id="faq-h" class="h2">Typiske spørgsmål.</h2>
          <a href="/faq/" class="link">Alle</a>
        </div>
        <FaqList items={homeFaq} />
      </div>
      <div class="drop card" data-home-drop>
        <Icon icon="upload" />
        <h3>Træk din fil hertil</h3>
        <p class="muted">Skitse, foto, PDF, DXF eller STEP. Du får en fast pris inden for {site.responseHours} timer.</p>
        <a href="/kontakt/" class="btn btn-primary" data-open-quote>Vælg filer</a>
      </div>
    </div>
  </section>

  <div class="mobile-only"><CTASection /></div>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero { padding-block: clamp(1.25rem, .5rem + 3vw, 4rem) clamp(1.5rem, 1rem + 2vw, 3rem); background: radial-gradient(60rem 30rem at 85% -10%, color-mix(in srgb, var(--c-orange) 7%, transparent), transparent 60%); }
  .hero__grid { display: grid; gap: 2rem; align-items: center; }
  .hero__visual { display: none; }
  @media (min-width: 64rem) { .hero__grid { grid-template-columns: 1.05fr 1fr; gap: 3.5rem; } .hero__visual { display: block; } }
  /* Computer: hero fylder første skærm, så næste sektion ikke bliver skåret over midt i fanerne */
  @media (min-width: 64rem) and (min-height: 40rem) { .hero { min-height: calc(100svh - var(--header-h)); display: grid; align-content: center; } }
  .pill { margin: 0; }
  .hero h1 { margin-top: 1rem; font-size: clamp(2rem, 1.2rem + 3.4vw, 3.6rem); }
  .hero .lead { margin-top: .9rem; }
  .hero__actions { display: grid; gap: .5rem; margin-top: 1.5rem; }
  .hero__cta { min-height: 3.25rem; font-size: 1rem; }
  .hero__alt { display: none; }
  @media (min-width: 36rem) { .hero__actions { display: flex; flex-wrap: wrap; } .hero__alt { display: inline-flex; } }
  .hero__trust { list-style: none; padding: 0; margin: 1.25rem 0 0; display: flex; flex-wrap: wrap; gap: .4rem 1.1rem; font-size: var(--fs-sm); color: var(--c-ink); }
  .hero__trust li { display: inline-flex; align-items: center; gap: .35rem; }
  .hero__trust :global(svg) { color: var(--c-orange); }
  .hero__trust-wide { display: none !important; }
  @media (min-width: 64rem) { .hero__trust-wide { display: inline-flex !important; } }

  .section--first { padding-top: clamp(1.5rem, 1rem + 2vw, 3.5rem); }
  .h2 { font-size: clamp(1.6rem, 1.1rem + 2vw, 2.6rem); letter-spacing: -0.035em; }
  .row-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-bottom: 1.25rem; }
  .row-head .link { font-size: var(--fs-sm); white-space: nowrap; }

  /* ---------- Ydelser ---------- */
  .tiles { list-style: none; padding: 0; margin: 1.25rem 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: .6rem; }
  .tile { display: grid; gap: .3rem; align-content: start; min-height: 7.5rem; padding: 1rem; text-decoration: none; color: inherit; }
  .tile strong { margin-top: .4rem; color: var(--c-ink); font-weight: 600; font-size: .9375rem; line-height: 1.25; }
  .tile span { font-size: var(--fs-xs); color: var(--c-muted); line-height: 1.4; }
  .tabs { display: none; }
  @media (min-width: 56rem) {
    .tiles { display: none; }
    .tabs { display: block; margin-top: 1.75rem; }
  }
  .tabs__list { display: flex; gap: .25rem; padding: 4px; background: var(--c-white); border: 1px solid var(--c-line); border-radius: 14px; width: fit-content; }
  .tabs__list button { display: inline-flex; align-items: center; gap: .5rem; min-height: 2.75rem; padding: 0 1rem; border: 0; border-radius: 10px; background: transparent; color: var(--c-muted); font: 500 .9375rem var(--font-sans); cursor: pointer; transition: background-color .2s ease, color .2s ease; }
  .tabs__list button:hover { color: var(--c-ink); }
  .tabs__list button[aria-selected="true"] { background: var(--c-ink); color: var(--c-on-ink); }
  .tabs__panel { margin-top: 1rem; display: grid; grid-template-columns: 1.1fr 1fr; gap: 2.5rem; align-items: center; padding: 8px 8px 8px 2.25rem; }
  .tabs__panel[hidden] { display: none; }
  .tabs__text { display: grid; gap: .9rem; padding-block: 1.5rem; }
  .tabs__text h3 { font-size: var(--fs-2xl); letter-spacing: -0.03em; }
  .tabs__text .kicker { margin: 0; }
  .tabs__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem; margin-top: .5rem; }
  .tabs__panel :global(.media), .tabs__panel :global(.ph) { border-radius: 16px; }
  .ticks { list-style: none; padding: 0; margin: 0; display: grid; gap: .45rem; font-size: var(--fs-sm); }
  .ticks li { position: relative; padding-left: 1.5rem; }
  .ticks li::before { content: ""; position: absolute; left: .15rem; top: .38em; width: .7rem; height: .38rem; border-left: 1.6px solid var(--c-orange); border-bottom: 1.6px solid var(--c-orange); transform: rotate(-45deg); }

  /* ---------- Cases ---------- */
  .cases { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: .75rem; margin-inline: calc(-1 * clamp(1.25rem, .5rem + 3vw, 2.5rem)); padding: 0 clamp(1.25rem, .5rem + 3vw, 2.5rem) .5rem; scrollbar-width: none; }
  .cases::-webkit-scrollbar { display: none; }
  .cases > :global(*) { flex: 0 0 min(80%, 20rem); scroll-snap-align: start; }
  @media (min-width: 56rem) { .cases { display: grid; grid-template-columns: repeat(3, 1fr); overflow: visible; margin: 0; padding: 0; } }

  /* ---------- Hvorfor ---------- */
  .why { margin-top: 1.75rem; padding-top: 1.5rem; border-top: 1px solid var(--c-line); display: grid; gap: 1rem; }
  .why__lead { font-size: var(--fs-sm); color: var(--c-muted); max-width: 60ch; }
  .why__lead strong { color: var(--c-ink); font-weight: 600; }
  .why__lead .link { margin-left: .25rem; }
  .why__list { display: none; list-style: none; padding: 0; margin: 0; }
  @media (min-width: 56rem) {
    .why { grid-template-columns: 1fr 1.3fr; align-items: center; gap: 3rem; }
    .why__list { display: flex; flex-wrap: wrap; gap: .5rem; }
    .why__list li { display: inline-flex; align-items: center; gap: .45rem; padding: .5rem .85rem; border: 1px solid var(--c-line); border-radius: 999px; font-size: var(--fs-sm); color: var(--c-ink); background: var(--c-paper); }
    .why__list :global(svg) { color: var(--c-orange); }
  }

  /* ---------- FAQ + dropfelt ---------- */
  .faq-cta { display: grid; gap: 2rem; }
  .drop { display: none; }
  @media (min-width: 56rem) {
    .faq-cta { grid-template-columns: 1.4fr 1fr; gap: 3rem; align-items: start; }
    .drop { display: grid; gap: .75rem; justify-items: start; padding: 2rem; border: 1.5px dashed var(--c-field); background: var(--c-white); transition: border-color .2s ease, background-color .2s ease; }
    .drop.is-dragover { border-color: var(--c-orange); background: color-mix(in srgb, var(--c-orange) 6%, var(--c-white)); }
    .drop h3 { font-size: var(--fs-xl); letter-spacing: -0.02em; }
  }
  .mobile-only { display: block; }
  @media (min-width: 56rem) { .mobile-only { display: none; } }
</style>

<script>
  // Faner (WAI-ARIA tabs): klik + piletaster
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role=tab]'));
    const select = (t: HTMLButtonElement, focus = false) => {
      tabs.forEach((x) => {
        const on = x === t;
        x.setAttribute('aria-selected', String(on));
        x.tabIndex = on ? 0 : -1;
        const p = document.getElementById(x.getAttribute('aria-controls')!);
        if (p) p.hidden = !on;
      });
      if (focus) t.focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (e) => {
        const k = e.key;
        if (k === 'ArrowRight' || k === 'ArrowLeft') {
          e.preventDefault();
          select(tabs[(i + (k === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length], true);
        }
      });
    });
  });

  // Dropfelt: træk filer ind → åbn tilbudsdialogen med filerne vedhæftet
  const drop = document.querySelector<HTMLElement>('[data-home-drop]');
  if (drop) {
    ['dragenter', 'dragover'].forEach((t) => drop.addEventListener(t, (e) => { e.preventDefault(); drop.classList.add('is-dragover'); }));
    ['dragleave', 'drop'].forEach((t) => drop.addEventListener(t, () => drop.classList.remove('is-dragover')));
    drop.addEventListener('drop', (e) => {
      e.preventDefault();
      const files = Array.from((e as DragEvent).dataTransfer?.files || []);
      (window as any).procadOpenQuote?.(undefined, files);
    });
  }
</script>
