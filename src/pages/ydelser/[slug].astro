---
// Ydelsesside – fungerer også som landingsside til Google Ads:
// én tydelig CTA og formularen ligger over folden på mobil (lige efter overskriften).
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import Media from '../../components/Media.astro';
import FaqList from '../../components/FaqList.astro';
import CaseCard from '../../components/CaseCard.astro';
import CTASection from '../../components/CTASection.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const services = await getCollection('ydelser');
  return services.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
interface Props { entry: CollectionEntry<'ydelser'> }
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const related = (await getCollection('cases')).filter((c) => c.data.service === entry.id).slice(0, 2);

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: d.title,
  serviceType: d.navTitle,
  description: d.metaDescription,
  url: `${site.url}/ydelser/${entry.id}/`,
  provider: { '@id': `${site.url}/#organization` },
  areaServed: { '@type': 'Country', name: 'Danmark' },
};
---
<BaseLayout title={d.metaTitle} description={d.metaDescription} schema={[serviceSchema]}>
  <section class="lp-hero grid-paper">
    <div class="container lp-hero__grid">
      <div class="lp-hero__copy">
        <Breadcrumbs items={[{ label: 'Ydelser', href: '/ydelser/' }, { label: d.navTitle, href: `/ydelser/${entry.id}/` }]} />
        <p class="kicker lp-hero__kicker">{d.problem}</p>
        <h1>{d.h1}</h1>
        <p class="lead">{d.intro}</p>
        <ul class="lp-hero__usp">
          <li><Icon icon="clock" tile={false} size={18} /> Svar inden for {site.responseHours} timer</li>
          <li><Icon icon="price" tile={false} size={18} /> Fast pris før start</li>
          <li><Icon icon="lock" tile={false} size={18} /> NDA ved behov</li>
        </ul>
      </div>
      <div class="lp-hero__form" id="tilbud">
        <QuoteForm id={`tilbud-${entry.id}`} compact preselect={entry.id} heading="Få en fast pris" submitLabel="Send og få en pris" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container lp-body">
      <div class="lp-body__main">
        <div class="prose"><Content /></div>
      </div>
      <aside class="lp-body__aside">
        <div class="card lp-deliv">
          <h2 class="lp-deliv__h">Du får</h2>
          <ul>
            {d.deliverables.map((x) => <li>{x}</li>)}
          </ul>
          {d.formats.length > 0 && (
            <dl class="titleblock lp-deliv__formats">
              <dt>Formater</dt><dd>{d.formats.join(', ')}</dd>
              <dt>Standard</dt><dd>DS/EN ISO</dd>
              <dt>Svartid</dt><dd>{site.responseHours} timer</dd>
            </dl>
          )}
          <a href="#tilbud" class="btn btn-primary btn-block">Få en fast pris</a>
        </div>
        <Media src={d.image.src} alt={d.image.alt} spec={d.image.spec} motif={d.image.motif} ratio="3 / 2" />
      </aside>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section bg-white border-y">
      <div class="container">
        <h2 class="lp-h2">Eksempler</h2>
        <div class="lp-cases">{related.map((c) => <CaseCard entry={c} />)}</div>
      </div>
    </section>
  )}

  {d.faq.length > 0 && (
    <section class="section">
      <div class="container lp-faq">
        <h2 class="lp-h2">Spørgsmål og svar</h2>
        <FaqList items={d.faq} />
      </div>
    </section>
  )}

  <CTASection preselect={entry.id} ctaHref="#tilbud" />
</BaseLayout>

<style>
  .lp-hero { padding-block: 2rem clamp(3rem, 2rem + 5vw, 6rem); }
  .lp-hero__grid { display: grid; gap: 2rem; }
  @media (min-width: 64rem) { .lp-hero__grid { grid-template-columns: 1.15fr 1fr; gap: 4rem; align-items: start; } }
  .lp-hero__kicker { margin: clamp(2rem, 1.5rem + 3vw, 4rem) 0 0; }
  .lp-hero h1 { margin-top: 1rem; font-size: clamp(2.4rem, 1.4rem + 3.4vw, 4rem); }
  .lp-hero .lead { margin-top: 1.25rem; }
  .lp-hero__usp { list-style: none; padding: 0; margin: 2rem 0 0; display: flex; flex-wrap: wrap; gap: .75rem 1.5rem; font-size: var(--fs-sm); color: var(--c-ink); }
  .lp-hero__usp li { display: flex; align-items: center; gap: .5rem; }
  .lp-hero__usp :global(svg) { color: var(--c-muted); }
  .lp-hero__form { background: var(--c-white); border: 1px solid var(--c-line); border-radius: var(--r-xl); box-shadow: var(--shadow-lg); padding: clamp(1.5rem, 3vw, 2.25rem); }
  @media (min-width: 64rem) { .lp-hero__form { margin-top: 3.5rem; } }
  /* Mobil: formularen højt oppe (Google Ads-landingsside) */
  @media (max-width: 39.99rem) { .lp-hero__usp { display: none; } .lp-hero .lead { font-size: var(--fs-base); } }

  .lp-body { display: grid; gap: 3rem; }
  @media (min-width: 64rem) { .lp-body { grid-template-columns: 1.4fr 1fr; gap: 5rem; } }
  .lp-body__aside { display: grid; gap: 1.5rem; align-content: start; }
  @media (min-width: 64rem) { .lp-body__aside { position: sticky; top: calc(var(--header-h) + 1.5rem); } }
  .lp-deliv { padding: 1.75rem; display: grid; gap: 1.25rem; }
  .lp-deliv__h { font-size: var(--fs-xl); letter-spacing: -0.025em; }
  .lp-deliv ul { list-style: none; padding: 0; margin: 0; display: grid; gap: .55rem; font-size: var(--fs-sm); }
  .lp-deliv li { padding-left: 1.6rem; position: relative; }
  .lp-deliv li::before { content: ""; position: absolute; left: .15rem; top: .38em; width: .7rem; height: .38rem; border-left: 1.6px solid var(--c-orange); border-bottom: 1.6px solid var(--c-orange); transform: rotate(-45deg); }
  .lp-h2 { margin-bottom: 2rem; font-size: var(--fs-2xl); letter-spacing: -0.03em; }
  .lp-cases { display: grid; gap: 1rem; }
  @media (min-width: 56rem) { .lp-cases { grid-template-columns: 1fr 1fr; } }
  .lp-faq { max-width: 52rem; }
</style>
