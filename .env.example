# Kopiér til .env og udfyld. Variabler med PUBLIC_ ender i den offentlige kode.

# Google Tag Manager-container (fx GTM-ABC1234). Tom = ingen tracking indlæses.
PUBLIC_GTM_ID=

# Hvor tilbudsformularen sender til.
# Simply.com (PHP): /api/tilbud.php   (standard)
# Vercel/Netlify:   fx https://formspree.io/f/xxxxxxx eller https://usebasin.com/f/xxxxxxx
PUBLIC_FORM_ENDPOINT=/api/tilbud.php

# Cloudflare Turnstile (valgfri – honeypot + tidsfælde er altid slået til)
PUBLIC_TURNSTILE_SITE_KEY=
