# Bloker direkte adgang til konfigurationsfiler
<FilesMatch "^(config|config\.sample)\.php$">
  Require all denied
</FilesMatch>

# Uploadgrænser (Simply.com tillader php_value i .htaccess – tjek med phpinfo() "Local value")
php_value upload_max_filesize 16M
php_value post_max_size 20M
php_value max_file_uploads 15
